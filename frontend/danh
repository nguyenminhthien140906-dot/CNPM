                    <button @click="viewSyllabusModal = false" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-xs font-semibold">Đóng Window</button>
                </div>
            </div>
        </div>

        <!-- MODAL: CHECKPOINT SUBMISSION -->
        <div v-if="showSubmitModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
            <div class="glass-panel w-full max-w-md rounded-2xl border border-slate-800 p-6 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                    <h3 class="font-bold text-base text-white">Nộp Bài Checkpoint</h3>
                    <button @click="showSubmitModal = false" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>
                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block text-slate-300 mb-1 font-semibold">Link Sản Phẩm (GitHub / Google Drive / Docs / Figma):</label>
                        <input type="url" v-model="submissionInputLink" placeholder="https://github.com/..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white">
                    </div>
                    <div>
                        <label class="block text-slate-300 mb-1 font-semibold">Ghi chú cho Giảng viên:</label>
                        <textarea v-model="submissionInputNotes" rows="3" placeholder="Mô tả tóm tắt nội dung bài nộp..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white"></textarea>
                    </div>
                </div>
                <div class="pt-3 border-t border-slate-800 flex justify-end gap-2">
                    <button @click="showSubmitModal = false" class="px-3.5 py-2 bg-slate-800 text-slate-300 rounded-lg text-xs font-medium">Hủy</button>
                    <button @click="submitCheckpointApi" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-lg transition-colors">
                        Xác nhận Nộp (POST /checkpoints/{id}/submit)
                    </button>
                </div>
            </div>
        </div>


        <!-- AI ASSISTANT FLOATING CHAT WIDGET -->
        <div class="fixed bottom-20 right-6 z-40">
            <!-- Chat Drawer Toggle FAB -->
            <button @click="aiDrawerOpen = !aiDrawerOpen" class="w-12 h-12 rounded-full bg-gradient-to-tr from-sky-500 to-indigo-600 text-white flex items-center justify-center shadow-2xl hover:scale-105 transition-transform">
                <i class="fa-solid fa-robot text-xl"></i>
            </button>

            <!-- Chat Drawer Box -->
            <div v-if="aiDrawerOpen" class="absolute bottom-16 right-0 w-80 sm:w-96 glass-panel rounded-2xl shadow-2xl border border-slate-700 flex flex-col h-96 overflow-hidden">
                <!-- Header -->
                <div class="p-3.5 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center text-xs"><i class="fa-solid fa-sparkles"></i></div>
                        <span class="font-bold text-xs text-white">AI Assistant Co-pilot</span>
                    </div>
                    <button @click="aiDrawerOpen = false" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
                </div>

                <!-- Chat Messages Body -->
                <div class="flex-1 p-3 overflow-y-auto space-y-3 text-xs">
                    <div v-for="msg in aiMessages" :key="msg.id" :class="msg.sender === 'user' ? 'justify-end' : 'justify-start'" class="flex">
