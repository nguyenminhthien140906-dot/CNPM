<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EduProject Hub - Academic Project Management System</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Vue 3 CDN -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen">
  <div id="app" class="flex flex-col h-screen overflow-hidden">
    
    <!-- TOP NAVBAR & ROLE SWITCHER -->
    <header class="bg-slate-800 border-b border-slate-700 px-6 py-3 flex items-center justify-between z-30 shrink-0">
      <div class="flex items-center space-x-3">
        <div class="bg-indigo-600 text-white p-2 rounded-lg font-bold text-xl flex items-center justify-center w-10 h-10 shadow-lg shadow-indigo-500/30">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg text-white leading-none">EduProject Hub</h1>
          <p class="text-xs text-slate-400 mt-0.5">Academic Project Management System</p>
        </div>
      </div>

      <!-- ROLE TOGGLE & SYSTEM NOTIFICATIONS -->
      <div class="flex items-center space-x-4">
        <!-- Role Switcher -->
        <div class="bg-slate-900/80 p-1 rounded-xl border border-slate-700 flex items-center">
          <button 
            @click="currentRole = 'lecturer'" 
            :class="currentRole === 'lecturer' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-400 hover:text-slate-200'"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 flex items-center space-x-2">
            <i class="fa-solid fa-chalkboard-user"></i>
            <span>Giảng viên (Lecturer UI)</span>
          </button>
          <button 
            @click="currentRole = 'student'" 
            :class="currentRole === 'student' ? 'bg-emerald-600 text-white shadow-md' : 'text-slate-400 hover:text-slate-200'"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 flex items-center space-x-2">
            <i class="fa-solid fa-user-graduate"></i>
            <span>Sinh viên (Student UI)</span>
          </button>
        </div>

        <!-- Notification Dropdown Toggle -->
        <div class="relative">
          <button @click="showNotifs = !showNotifs" class="relative p-2 text-slate-300 hover:text-white bg-slate-700/50 hover:bg-slate-700 rounded-lg transition-colors">
            <i class="fa-solid fa-bell"></i>
            <span v-if="unreadNotifsCount > 0" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center animate-pulse">
              {{ unreadNotifsCount }}
            </span>
          </button>

          <!-- Notification Drawer Popover -->
          <div v-if="showNotifs" class="absolute right-0 mt-2 w-80 bg-slate-800 border border-slate-700 rounded-xl shadow-2xl z-50 overflow-hidden">
            <div class="px-4 py-3 bg-slate-800/90 border-b border-slate-700 flex justify-between items-center">
              <span class="font-semibold text-sm">Thông báo Realtime</span>
              <span class="text-xs text-slate-400">{{ notifications.length }} tin</span>
            </div>
            <div class="max-h-64 overflow-y-auto custom-scrollbar divide-y divide-slate-700/50">
              <div v-for="notif in notifications" :key="notif.id" class="p-3 hover:bg-slate-700/30 transition-colors">
                <p class="text-xs text-slate-200 font-medium">{{ notif.title }}</p>
                <p class="text-[11px] text-slate-400 mt-1">{{ notif.message }}</p>
                <span class="text-[10px] text-slate-500 mt-1 block">{{ notif.time }}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- MAIN APP LAYOUT (SIDEBAR + CONTENT) -->
    <div class="flex flex-1 overflow-hidden">
      
      <!-- SIDEBAR NAVIGATION -->
      <aside class="w-64 bg-slate-800/50 border-r border-slate-700 flex flex-col justify-between shrink-0">
        <div class="p-4 space-y-6">
          
          <!-- LECTURER NAVIGATION -->
          <div v-if="currentRole === 'lecturer'">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 px-3">Giao diện Giảng viên</div>
            <nav class="space-y-1">
              <button @click="lecturerView = 'dashboard'" :class="lecturerView === 'dashboard' ? 'bg-indigo-600/20 text-indigo-400 border-l-4 border-indigo-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                <span>Dashboard</span>
              </button>
              <button @click="lecturerView = 'subjects'" :class="lecturerView === 'subjects' ? 'bg-indigo-600/20 text-indigo-400 border-l-4 border-indigo-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-book-bookmark w-5 text-center"></i>
                <span>Môn học & Syllabus</span>
              </button>
              <button @click="lecturerView = 'classes'" :class="lecturerView === 'classes' ? 'bg-indigo-600/20 text-indigo-400 border-l-4 border-indigo-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-users-rectangle w-5 text-center"></i>
                <span>Quản lý Lớp học</span>
              </button>
              <button @click="lecturerView = 'projects'" :class="lecturerView === 'projects' ? 'bg-indigo-600/20 text-indigo-400 border-l-4 border-indigo-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-folder-tree w-5 text-center"></i>
                <span>Kho & Duyệt Đề tài</span>
              </button>
              <button @click="lecturerView = 'milestones'" :class="lecturerView === 'milestones' ? 'bg-indigo-600/20 text-indigo-400 border-l-4 border-indigo-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-timeline w-5 text-center"></i>
                <span>Cột mốc & Milestone</span>
              </button>
              <button @click="lecturerView = 'evaluations'" :class="lecturerView === 'evaluations' ? 'bg-indigo-600/20 text-indigo-400 border-l-4 border-indigo-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-clipboard-check w-5 text-center"></i>
                <span>Chấm điểm & Feedback</span>
              </button>
            </nav>
          </div>

          <!-- STUDENT NAVIGATION -->
          <div v-else>
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 px-3">Giao diện Sinh viên</div>
            <nav class="space-y-1">
              <button @click="studentView = 'dashboard'" :class="studentView === 'dashboard' ? 'bg-emerald-600/20 text-emerald-400 border-l-4 border-emerald-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-house w-5 text-center"></i>
                <span>Dashboard</span>
              </button>
              <button @click="studentView = 'teams'" :class="studentView === 'teams' ? 'bg-emerald-600/20 text-emerald-400 border-l-4 border-emerald-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-user-group w-5 text-center"></i>
                <span>Nhóm của tôi</span>
              </button>
              <button @click="studentView = 'projects'" :class="studentView === 'projects' ? 'bg-emerald-600/20 text-emerald-400 border-l-4 border-emerald-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-lightbulb w-5 text-center"></i>
                <span>Đăng ký / Đề xuất Project</span>
              </button>
              <button @click="studentView = 'tasks'" :class="studentView === 'tasks' ? 'bg-emerald-600/20 text-emerald-400 border-l-4 border-emerald-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-list-check w-5 text-center"></i>
                <span>Task Board (Kanban)</span>
              </button>
              <button @click="studentView = 'checkpoints'" :class="studentView === 'checkpoints' ? 'bg-emerald-600/20 text-emerald-400 border-l-4 border-emerald-500' : 'text-slate-300 hover:bg-slate-700/40'" class="w-full text-left px-3 py-2.5 rounded-r-lg text-sm font-medium flex items-center space-x-3 transition-colors">
                <i class="fa-solid fa-upload w-5 text-center"></i>
                <span>Nộp bài Checkpoint</span>
              </button>
            </nav>
          </div>

        </div>

        <!-- USER PROFILE FOOTER -->
        <div class="p-4 border-t border-slate-700/60 bg-slate-800/80 flex items-center space-x-3">
          <div class="w-9 h-9 rounded-full bg-slate-700 border border-slate-600 flex items-center justify-center font-bold text-sm text-indigo-400">
            {{ currentRole === 'lecturer' ? 'GV' : 'SV' }}
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-semibold text-white truncate">{{ currentRole === 'lecturer' ? 'TS. Nguyễn Văn A' : 'Lê Văn B (Leader)' }}</p>
            <p class="text-[11px] text-slate-400 truncate">{{ currentRole === 'lecturer' ? 'lecturer@university.edu.vn' : 'student@university.edu.vn' }}</p>
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT DISPLAY AREA -->
      <main class="flex-1 overflow-y-auto custom-scrollbar p-6 bg-slate-900/90 relative">
        
        <!-- ================= LECTURER VIEWS ================= -->
        <div v-if="currentRole === 'lecturer'">
          
          <!-- LECTURER DASHBOARD -->
          <div v-if="lecturerView === 'dashboard'" class="space-y-6">
            <div class="flex justify-between items-center">
              <div>
                <h2 class="text-xl font-bold text-white">Tổng quan Giảng viên</h2>
                <p class="text-xs text-slate-400 mt-1">Theo dõi hoạt động các lớp học và bài nộp gần đây</p>
              </div>
            </div>

            <!-- Metric Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4">
                <p class="text-xs text-slate-400">Số lớp đang dạy</p>
                <p class="text-2xl font-bold text-indigo-400 mt-1">4 Lớp</p>
              </div>
              <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4">
                <p class="text-xs text-slate-400">Đề tài chờ duyệt</p>
                <p class="text-2xl font-bold text-amber-400 mt-1">3 Yêu cầu</p>
              </div>
              <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4">
                <p class="text-xs text-slate-400">Checkpoint chờ chấm</p>
                <p class="text-2xl font-bold text-rose-400 mt-1">8 Bài nộp</p>
              </div>
              <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4">
                <p class="text-xs text-slate-400">Tổng sinh viên</p>
                <p class="text-2xl font-bold text-emerald-400 mt-1">142 SV</p>
              </div>
            </div>
          </div>

          <!-- SUBJECTS & SYLLABUS SCREEN -->
          <div v-if="lecturerView === 'subjects'" class="space-y-6">
            <div class="flex justify-between items-center">
              <div>
                <h2 class="text-xl font-bold text-white">Môn học & Syllabus (/subjects)</h2>
                <p class="text-xs text-slate-400 mt-1">Quản lý môn học và xây dựng cấu trúc Syllabus bài giảng</p>
              </div>
              <button @click="logAPI('POST', '/subjects', { name: 'Môn học mới', code: 'CS302' })" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-2">
                <i class="fa-solid fa-plus"></i>
                <span>Tạo Môn Học</span>
              </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <!-- Subject List Card -->
              <div v-for="subj in subjects" :key="subj.id" class="bg-slate-800 border border-slate-700 rounded-xl p-5 hover:border-indigo-500/50 transition-all">
                <div class="flex justify-between items-start">
                  <span class="text-xs font-bold text-indigo-400 bg-indigo-500/10 px-2 py-1 rounded border border-indigo-500/20">{{ subj.code }}</span>
                  <span class="text-xs text-slate-400">{{ subj.credits }} Tín chỉ</span>
                </div>
                <h3 class="font-bold text-white mt-3">{{ subj.name }}</h3>
                <p class="text-xs text-slate-400 mt-2 line-clamp-2">{{ subj.description }}</p>
                
                <div class="mt-4 pt-4 border-t border-slate-700/60 flex justify-between items-center">
                  <button @click="logAPI('GET', `/subjects/${subj.id}/syllabus`)" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium">
                    Xem Syllabus
                  </button>
                  <button @click="logAPI('POST', `/subjects/${subj.id}/syllabus`, { updated: true })" class="text-xs text-slate-300 hover:text-white bg-slate-700 px-2.5 py-1 rounded">
                    + Cập nhật Syllabus
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- CLASS MANAGEMENT SCREEN -->
          <div v-if="lecturerView === 'classes'" class="space-y-6">
            <div class="flex justify-between items-center">
              <div>
                <h2 class="text-xl font-bold text-white">Quản lý Lớp học (/classes)</h2>
                <p class="text-xs text-slate-400 mt-1">Danh sách các lớp học, gán giảng viên hỗ trợ và quản lý danh sách SV</p>
              </div>
              <button @click="logAPI('POST', '/classes', { name: 'SE104.O12', subjectId: 1 })" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-2">
                <i class="fa-solid fa-plus"></i>
                <span>Tạo Lớp Mới</span>
              </button>
            </div>

            <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-800/80 text-slate-400 border-b border-slate-700">
                  <tr>
                    <th class="p-3">Mã Lớp</th>
                    <th class="p-3">Môn học</th>
                    <th class="p-3">Sĩ số</th>
                    <th class="p-3">Giảng viên phụ trách</th>
                    <th class="p-3 text-right">Thao tác API Mapping</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-700/50">
                  <tr v-for="cls in classesList" :key="cls.id" class="hover:bg-slate-700/20">
                    <td class="p-3 font-semibold text-indigo-400">{{ cls.code }}</td>
                    <td class="p-3 text-slate-200">{{ cls.subject }}</td>
                    <td class="p-3 text-slate-300">{{ cls.studentsCount }} SV</td>
                    <td class="p-3 text-slate-300">{{ cls.lecturers.join(', ') }}</td>
                    <td class="p-3 text-right space-x-2">
                      <button @click="logAPI('POST', `/classes/${cls.id}/students`, { list: ['SV001', 'SV002'] })" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-2 py-1 rounded">
                        + Import SV
                      </button>
                      <button @click="logAPI('POST', `/classes/${cls.id}/lecturer`, { lecturerId: 2 })" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-2 py-1 rounded">
                        + Thêm GV
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- PROJECT POOL & APPROVAL SCREEN -->
          <div v-if="lecturerView === 'projects'" class="space-y-6">
            <div class="flex justify-between items-center">
              <div>
                <h2 class="text-xl font-bold text-white">Duyệt & Quản lý Đề tài (/projects)</h2>
                <p class="text-xs text-slate-400 mt-1">Quản lý Kho đề tài và Thẩm định các đề tài do sinh viên tự đề xuất</p>
              </div>
              <button @click="logAPI('POST', '/projects', { title: 'Đề tài mẫu mới' })" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-2">
                <i class="fa-solid fa-plus"></i>
                <span>Tạo Đề Tài Mẫu</span>
              </button>
            </div>

            <!-- Tabs selector -->
            <div class="flex space-x-4 border-b border-slate-700 pb-2">
              <button @click="projectTab = 'pool'" :class="projectTab === 'pool' ? 'text-indigo-400 font-bold border-b-2 border-indigo-500' : 'text-slate-400'" class="pb-2 text-xs">
                Kho đề tài (Project Pool)
              </button>
              <button @click="projectTab = 'pending'" :class="projectTab === 'pending' ? 'text-indigo-400 font-bold border-b-2 border-indigo-500' : 'text-slate-400'" class="pb-2 text-xs flex items-center space-x-2">
                <span>Đề tài chờ duyệt (Pending Requests)</span>
                <span class="bg-amber-500/20 text-amber-400 text-[10px] px-1.5 py-0.5 rounded-full font-bold">2</span>
              </button>
            </div>

            <!-- Tab: Project Pool -->
            <div v-if="projectTab === 'pool'" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div v-for="proj in projectPool" :key="proj.id" class="bg-slate-800 border border-slate-700 rounded-xl p-4">
                <div class="flex justify-between items-start">
                  <h4 class="font-bold text-sm text-white">{{ proj.title }}</h4>
                  <span class="text-[10px] bg-slate-700 text-slate-300 px-2 py-0.5 rounded">{{ proj.category }}</span>
                </div>
                <p class="text-xs text-slate-400 mt-2">{{ proj.description }}</p>
                <div class="mt-4 pt-3 border-t border-slate-700/60 flex justify-between items-center">
                  <button @click="logAPI('PUT', `/projects/${proj.id}`, { status: 'updated' })" class="text-xs text-slate-300 hover:text-white">
                    <i class="fa-solid fa-pen-to-square"></i> Chỉnh sửa
                  </button>
                  <button @click="logAPI('POST', `/projects/${proj.id}/assign-class`, { classId: 'SE104.O12' })" class="text-xs bg-indigo-600/30 text-indigo-300 hover:bg-indigo-600/50 px-2.5 py-1 rounded">
                    Gán vào Lớp học
                  </button>
                </div>
              </div>
            </div>

            <!-- Tab: Pending Requests -->
            <div v-if="projectTab === 'pending'" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div v-for="req in pendingProjects" :key="req.id" class="bg-slate-800 border border-amber-500/30 rounded-xl p-4">
                <div class="flex justify-between items-start">
                  <h4 class="font-bold text-sm text-amber-300">{{ req.title }}</h4>
                  <span class="text-[10px] bg-amber-500/10 text-amber-400 px-2 py-0.5 rounded border border-amber-500/20">Chờ duyệt</span>
                </div>
                <p class="text-xs text-slate-400 mt-2">{{ req.description }}</p>
                <p class="text-[11px] text-slate-500 mt-2">Đề xuất bởi: <span class="text-slate-300">{{ req.proposedBy }}</span></p>
                
                <div class="mt-4 pt-3 border-t border-slate-700/60 flex justify-end space-x-2">
                  <button @click="logAPI('POST', `/projects/${req.id}/deny`, { reason: 'Cần làm rõ phạm vi' })" class="bg-rose-500/20 text-rose-300 hover:bg-rose-500/30 px-3 py-1 rounded text-xs">
                    Từ chối
                  </button>
                  <button @click="logAPI('POST', `/projects/${req.id}/approve`, {})" class="bg-emerald-600 text-white hover:bg-emerald-500 px-3 py-1 rounded text-xs font-semibold">
                    Duyệt Đề Tài
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- MILESTONES & TIMELINE SCREEN -->
          <div v-if="lecturerView === 'milestones'" class="space-y-6">
            <div class="flex justify-between items-center">
              <div>
                <h2 class="text-xl font-bold text-white">Cột mốc & Checkpoint (/milestones)</h2>
                <p class="text-xs text-slate-400 mt-1">Lập tiến độ Gantt/Timeline và gán các mốc Checkpoint cho dự án</p>
              </div>
              <div class="space-x-2">
                <button @click="logAPI('POST', '/projects/1/milestones', { title: 'New Milestone' })" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-lg text-xs font-semibold">
                  + Tạo Cột Mốc (Milestone)
                </button>
                <button @click="logAPI('POST', '/teams/101/checkpoints', { title: 'Checkpoint N' })" class="bg-slate-700 hover:bg-slate-600 text-white px-3 py-2 rounded-lg text-xs font-semibold">
                  + Tạo Checkpoint Nhóm
                </button>
              </div>
            </div>

            <!-- Gantt / Timeline Visual -->
            <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 space-y-4">
