                              <button 
                                onClick={() => {
                                  logAPI('POST', `/api/v1/teams/${teamInfo.id}/select-project`, { projectId: p.id });
                                  setTeamInfo({ ...teamInfo, projectTitle: p.title });
                                }} 
                                className="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded-lg text-xs font-semibold w-full mt-2 transition"
                              >
                                Đăng ký Đề tài này
                              </button>
                            </div>
                          ))}
                        </div>
                      </div>

                      {/* Custom Proposal */}
                      <div className="bg-slate-800 border border-slate-700/80 rounded-2xl p-5 space-y-4">
                        <h3 className="font-bold text-sm text-white flex items-center space-x-2">
                          <Lightbulb className="w-4 h-4 text-indigo-400" />
                          <span>Tự Đề xuất Đề tài Mới</span>
                        </h3>
                        <form onSubmit={(e) => {
                          e.preventDefault();
                          if(!proposalInput.title) return;
                          const newProp = { id: `PROP-${Date.now()}`, title: proposalInput.title, description: proposalInput.description, proposedBy: 'Lê Văn B (20520001)', teamName: teamInfo.name };
                          logAPI('POST', '/api/v1/projects/propose', newProp);
                          setPendingProposals([...pendingProposals, newProp]);
                          setProposalInput({ title: '', description: '' });
                        }} className="space-y-3">
                          <div>
                            <label className="block text-xs font-medium text-slate-400 mb-1">Tên đề tài đề xuất</label>
                            <input 
                              type="text" 
                              value={proposalInput.title}
                              onChange={e => setProposalInput({ ...proposalInput, title: e.target.value })}
                              className="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-indigo-500" 
                              placeholder="Nhập tên đề tài..."
                            />
                          </div>
                          <div>
                            <label className="block text-xs font-medium text-slate-400 mb-1">Mô tả công nghệ & mục tiêu</label>
                            <textarea 
                              rows={3} 
                              value={proposalInput.description}
                              onChange={e => setProposalInput({ ...proposalInput, description: e.target.value })}
                              className="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-indigo-500" 
                              placeholder="Mô tả chi tiết..."
                            />
                          </div>
                          <button type="submit" className="w-full bg-indigo-600 hover:bg-indigo-500 text-white py-2.5 rounded-xl text-xs font-semibold transition">
                            Gửi Đề Xuất Cho Giảng Viên
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                )}

                {/* 4. KANBAN TASK BOARD */}
                {studentView === 'tasks' && (
                  <div className="space-y-6">
                    <div className="flex justify-between items-center">
                      <div>
                        <h2 className="text-xl font-bold text-white">Task Board (Kanban)</h2>
                        <p className="text-xs text-slate-400 mt-1">Phân chia công việc và theo dõi tiến độ nhóm (/api/v1/tasks)</p>
                      </div>
                    </div>

                    {/* New Task Form */}
                    <form onSubmit={handleCreateTask} className="bg-slate-800 border border-slate-700/80 rounded-2xl p-4 flex gap-3 items-center">
                      <input 
                        type="text" 
                        value={newTaskTitle} 
                        onChange={e => setNewTaskTitle(e.target.value)} 
                        placeholder="Thêm task công việc mới..." 
                        className="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500"
                      />
                      <select 
                        value={newTaskAssignee} 
                        onChange={e => setNewTaskAssignee(e.target.value)}
                        className="bg-slate-900 border border-slate-700 text-slate-300 text-xs rounded-xl px-3 py-2 focus:outline-none"
                      >
                        {teamInfo.members.map(m => <option key={m.id} value={m.name}>{m.name}</option>)}
                      </select>
                      <button type="submit" className="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl text-xs font-semibold shrink-0">
                        + Tạo Task
                      </button>
                    </form>

                    {/* Kanban Columns */}
                    <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                      {[
                        { key: 'todo', label: 'To Do', color: 'text-slate-400' },
                        { key: 'in_progress', label: 'In Progress', color: 'text-amber-400' },
                        { key: 'review', label: 'Code Review', color: 'text-indigo-400' },
                        { key: 'done', label: 'Done', color: 'text-emerald-400' }
                      ].map(col => {
                        const colTasks = tasks.filter(t => t.status === col.key);
                        return (
                          <div key={col.key} className="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-3 space-y-3 min-h-[300px]">
                            <div className="flex justify-between items-center px-1">
                              <span className={`text-xs font-bold uppercase tracking-wider ${col.color}`}>{col.label}</span>
                              <span className="text-[10px] bg-slate-700 text-slate-300 px-2 py-0.5 rounded-full font-bold">{colTasks.length}</span>
                            </div>

                            <div className="space-y-2">
                              {colTasks.map(task => (
                                <div key={task.id} className="bg-slate-800 border border-slate-700 rounded-xl p-3 space-y-2 shadow-sm">
                                  <p className="text-xs font-semibold text-white leading-snug">{task.title}</p>
                                  <div className="flex justify-between items-center text-[10px] text-slate-400">
                                    <span>Gán: <span className="text-slate-200">{task.assignee}</span></span>
                                  </div>
                                  <div className="pt-2 border-t border-slate-700/50 flex justify-between gap-1">
                                    {col.key !== 'todo' && (
                                      <button onClick={() => handleMoveTask(task.id, col.key === 'done' ? 'review' : col.key === 'review' ? 'in_progress' : 'todo')} className="text-[10px] text-slate-400 hover:text-white">
                                        &larr; Lùi
                                      </button>
                                    )}
                                    {col.key !== 'done' && (
                                      <button onClick={() => handleMoveTask(task.id, col.key === 'todo' ? 'in_progress' : col.key === 'in_progress' ? 'review' : 'done')} className="text-[10px] text-emerald-400 hover:underline ml-auto">
                                        Tiến &rarr;
                                      </button>
                                    )}
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}

                {/* 5. CHECKPOINT SUBMISSION */}
                {studentView === 'checkpoints' && (
                  <div className="space-y-6">
                    <div>
                      <h2 className="text-xl font-bold text-white">Nộp bài Checkpoint Progress</h2>
                      <p className="text-xs text-slate-400 mt-1">Nộp báo cáo, repository link và tài nguyên bài làm (/api/v1/checkpoints)</p>
                    </div>

                    <form onSubmit={handleSubmitCheckpoint} className="bg-slate-800 border border-slate-700/80 rounded-2xl p-6 max-w-2xl space-y-4">
                      <div>
                        <label className="block text-xs font-medium text-slate-400 mb-1">Chọn Checkpoint Mốc Tiến Độ</label>
                        <select 
                          value={checkpointInput.checkpointName} 
                          onChange={e => setCheckpointInput({ ...checkpointInput, checkpointName: e.target.value })}
                          className="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-emerald-500"
                        >
                          <option value="Checkpoint 1: SRS & Requirement Document">Checkpoint 1: SRS & Requirement Document</option>
                          <option value="Checkpoint 2: Database Schema & API Docs">Checkpoint 2: Database Schema & API Docs</option>
                          <option value="Checkpoint 3: MVP Demo & Source Code">Checkpoint 3: MVP Demo & Source Code</option>
                        </select>
                      </div>

                      <div>
                        <label className="block text-xs font-medium text-slate-400 mb-1">GitHub Repository Link / Document URL</label>
                        <input 
                          type="url" 
                          required
                          value={checkpointInput.repoLink} 
                          onChange={e => setCheckpointInput({ ...checkpointInput, repoLink: e.target.value })}
                          placeholder="https://github.com/..." 
                          className="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-emerald-500"
                        />
                      </div>

                      <div>
                        <label className="block text-xs font-medium text-slate-400 mb-1">Ghi chú gửi Giảng viên</label>
                        <textarea 
                          rows={3} 
                          value={checkpointInput.note} 
                          onChange={e => setCheckpointInput({ ...checkpointInput, note: e.target.value })}
                          placeholder="Mô tả nội dung bài nộp..." 
                          className="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-emerald-500"
                        />
                      </div>

                      <button type="submit" className="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-3 rounded-xl text-xs font-semibold transition">
                        Nộp Bài Checkpoint Ngay
                      </button>
                    </form>
                  </div>
                )}
              </>
            )}

            {/* 7. RESOURCES & ATTACHMENTS (COMMON SHARED) */}
            {((currentRole === 'lecturer' && lecturerView === 'resources') || (currentRole === 'student' && studentView === 'resources')) && (
              <div className="space-y-6">
                <div className="flex justify-between items-center">
                  <div>
                    <h2 className="text-xl font-bold text-white">Kho Tài nguyên & Tài liệu</h2>
                    <p className="text-xs text-slate-400 mt-1">Chia sẻ tài liệu học tập, biểu mẫu và tài nguyên dự án (/api/v1/resources)</p>
                  </div>
                </div>

                {/* Resource Upload Form */}
                <form onSubmit={handleAddResource} className="bg-slate-800 border border-slate-700/80 rounded-2xl p-4 flex gap-3 items-center">
                  <input 
                    type="text" 
                    value={newResTitle} 
                    onChange={e => setNewResTitle(e.target.value)} 
                    placeholder="Tên tài nguyên / Tài liệu..." 
                    className="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500"
                  />
                  <input 
                    type="url" 
                    value={newResUrl} 
                    onChange={e => setNewResUrl(e.target.value)} 
                    placeholder="Link URL tài liệu..." 
                    className="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500"
                  />
                  <button type="submit" className="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-xl text-xs font-semibold shrink-0">
                    + Thêm Link
                  </button>
                </form>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {resources.map(r => (
                    <div key={r.id} className="bg-slate-800 border border-slate-700/80 rounded-2xl p-4 flex justify-between items-center">
                      <div className="flex items-center space-x-3">
                        <FileText className="w-5 h-5 text-indigo-400" />
                        <div>
                          <p className="text-xs font-bold text-white">{r.title}</p>
                          <span className="text-[10px] text-slate-400">Đăng bởi: {r.sharedBy}</span>
                        </div>
                      </div>
                      <a href={r.url} target="_blank" rel="noreferrer" className="text-xs text-indigo-400 hover:underline flex items-center space-x-1">
                        <span>Mở Link</span>
                        <ExternalLink className="w-3 h-3" />
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>

          {/* ================= REALTIME API INSPECTOR CONSOLE ================= */}
          <div className="mt-8 border-t border-slate-800 pt-4">
            <div className="flex justify-between items-center mb-2">
              <span className="text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center space-x-2">
                <Terminal className="w-4 h-4 text-emerald-400" />
                <span>REST API Payload Contract Inspector</span>
              </span>
              <button onClick={() => setApiLogs([])} className="text-[10px] text-slate-500 hover:text-slate-300"> 
              Clear Logs
              </button>
            </div>
            <div className="bg-slate-950/90 rounded-2xl p-3 font-mono text-[11px] text-emerald-400 max-h-32 overflow-y-auto border border-slate-800 space-y-1">
              {apiLogs.length === 0 ? (
                <div className="text-slate-600 italic">Thực hiện các thao tác trên giao diện để xem mã payload REST API tương ứng...</div>
              ) : (
                apiLogs.map(log => (
                  <div key={log.id} className="flex space-x-2">
                    <span className="text-slate-500">[{log.time}]</span>
                    <span className={`font-bold ${log.method === 'GET' ? 'text-blue-400' : log.method === 'POST' ? 'text-emerald-400' : 'text-amber-400'}`}>
                      {log.method}
                    </span>
                    <span className="text-slate-200">{log.endpoint}</span>
                    <span className="text-slate-500 truncate">{log.payload ? JSON.stringify(log.payload) : ''}</span>
                  </div>
                ))
              )}
            </div>
          </div>

        </main>
      </div>
    </div>
  );
}
