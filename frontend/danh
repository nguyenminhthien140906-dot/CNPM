                            {{ msg.text }}
                        </div>
                    </div>
                </div>

                <!-- Suggested Quick Actions (Context Sensitive) -->
                <div class="p-2 bg-slate-900/60 border-t border-slate-800 flex gap-1.5 overflow-x-auto text-[10px]">
                    <template v-if="currentRole === 'lecturer'">
                        <button @click="triggerAiPrompt('Gợi ý cấu trúc Syllabus môn học')" class="px-2 py-1 bg-sky-950 text-sky-300 rounded border border-sky-800 shrink-0">Gợi ý Syllabus</button>
                        <button @click="triggerAiPrompt('Sinh tiêu chí đánh giá Checkpoint')" class="px-2 py-1 bg-indigo-950 text-indigo-300 rounded border border-indigo-800 shrink-0">Sinh tiêu chí Checkpoint</button>
                    </template>
                    <template v-else>
                        <button @click="triggerAiPrompt('Phân rã Milestone thành Tasks')" class="px-2 py-1 bg-emerald-950 text-emerald-300 rounded border border-emerald-800 shrink-0">Phân rã Tasks</button>
                        <button @click="triggerAiPrompt('Kiểm tra tiến độ làm việc của nhóm')" class="px-2 py-1 bg-amber-950 text-amber-300 rounded border border-amber-800 shrink-0">Kiểm tra tiến độ</button>
                    </template>
                </div>

                <!-- Input Box -->
                <div class="p-2 bg-slate-900 border-t border-slate-800 flex gap-2">
                    <input type="text" v-model="aiInput" @keyup.enter="sendAiMessage" placeholder="Hỏi AI Assistant..." class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none">
                    <button @click="sendAiMessage" class="px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold rounded-lg">Gửi</button>
                </div>
            </div>
        </div>

        <!-- FLOATING REALTIME API TOAST INSPECTOR BANNER -->
        <div v-if="apiLog" class="fixed bottom-4 left-6 z-50 transition-all duration-300 max-w-md">
            <div class="glass-panel p-3 rounded-xl border border-emerald-500/50 shadow-2xl bg-slate-950/90 text-xs font-mono space-y-1">
                <div class="flex items-center justify-between border-b border-slate-800 pb-1">
                    <span class="text-emerald-400 font-bold flex items-center gap-1.5">
                        <i class="fa-solid fa-network-wired"></i> API Call Executed [200 OK]
                    </span>
                    <button @click="apiLog = null" class="text-slate-500 hover:text-slate-300"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="text-sky-300 font-bold"><span class="text-amber-400">{{ apiLog.method }}</span> {{ apiLog.url }}</div>
                <div v-if="apiLog.payload" class="text-[10px] text-slate-400 truncate">Payload: {{ JSON.stringify(apiLog.payload) }}</div>
            </div>
        </div>

    </div>

    <script>
        const { createApp, ref, computed } = Vue;

        createApp({
            setup() {
                // Application State Variables
                const currentRole = ref('lecturer'); // 'lecturer' | 'student'
                const currentTab = ref('lecturer-dashboard');
                const showNotifications = ref(false);
                const viewSyllabusModal = ref(false);
                const showSubmitModal = ref(false);
                const aiDrawerOpen = ref(false);
                const apiLog = ref(null);

                // User Context
                const currentUser = computed(() => {
                    return currentRole.value === 'lecturer' 
                        ? { name: 'TS. Nguyễn Văn A', roleTitle: 'Giảng viên Phụ trách', avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80' }
                        : { name: 'Trần Thị B', roleTitle: 'Sinh viên - SV100248', avatar: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&auto=format&fit=crop&q=80' };
                });

                // Notifications Mock Data
                const notifications = ref([
                    { id: 1, type: 'submission', message: 'Nhóm Alpha vừa nộp bài Checkpoint 2 môn SE101', time: '5 phút trước' },
                    { id: 2, type: 'approve', message: 'Đề tài "Website Quản lý Đồ án" đã được duyệt', time: '1 giờ trước' },
                    { id: 3, type: 'feedback', message: 'Giảng viên đã gửi feedback cho Checkpoint 1', time: '3 giờ trước' }
                ]);
                const unreadNotificationsCount = computed(() => notifications.value.length);

                // Mock Subjects Data
                const subjects = ref([
                    { id: 1, code: 'SE101', name: 'Nhập môn Công nghệ Phần mềm', credits: 3, description: 'Cung cấp kiến thức tổng quan về quy trình phát triển phần mềm Agile/Scrum.', syllabusVersion: '2.1' },
                    { id: 2, code: 'CS202', name: 'Phát triển Ứng dụng Web', credits: 4, description: 'Xây dựng ứng dụng web hiện đại với Frontend Frameworks & RESTful APIs.', syllabusVersion: '1.4' }
                ]);

                // Mock Classes Data
                const classes = ref([
                    { 
                        id: 1, code: 'SE101.O12', name: 'Công nghệ phần mềm - Nhóm 12', subjectName: 'Nhập môn Công nghệ Phần mềm', progress: 65, teamsCount: 6, studentsCount: 36,
                        students: [
                            { id: 1, code: 'SV100248', name: 'Trần Thị B', email: 'tranb@student.edu.vn', team: 'Nhóm Alpha' },
                            { id: 2, code: 'SV100249', name: 'Lê Văn C', email: 'levanc@student.edu.vn', team: 'Nhóm Alpha' },
                            { id: 3, code: 'SV100250', name: 'Phạm Minh D', email: 'phamd@student.edu.vn', team: 'Chưa có nhóm' }
                        ],
                        coLecturers: [{ id: 101, name: 'ThS. Trần Văn X', email: 'tranvanx@university.edu.vn' }]
                    },
                    { 
                        id: 2, code: 'CS202.N11', name: 'Web Dev - Nhóm 11', subjectName: 'Phát triển Ứng dụng Web', progress: 40, teamsCount: 5, studentsCount: 30,
                        students: [], coLecturers: []
                    }
                ]);
                const selectedClass = ref(classes.value[0]);
                const classActiveTab = ref('students');

                // Mock Projects Data
                const projectPool = ref([
                    { id: 1, title: 'Hệ thống Quản lý Đồ án Sinh viên (EduProject)', description: 'Xây dựng web app quản lý tiến độ, duyệt đề tài và chấm điểm checkpoint.', category: 'Web Application', author: 'TS. Nguyễn Văn A', assignedClass: 'SE101.O12' },
                    { id: 2, title: 'Ứng dụng Điểm danh Sinh viên bằng AI FaceID', description: 'Ứng dụng di động nhận diện khuôn mặt điểm danh sinh viên trong lớp học.', category: 'AI / Mobile', author: 'TS. Nguyễn Văn A', assignedClass: 'CS202.N11' }
                ]);

                const pendingProjects = ref([
                    { id: 101, title: 'Ứng dụng Tìm kiếm Nhà trọ Sinh viên tích hợp Maps', description: 'Đề xuất giải pháp hỗ trợ tân sinh viên tìm phòng trọ uy tín quanh khu vực đại học.', teamName: 'Nhóm Innovation', className: 'SE101.O12' }
                ]);

                // Mock Milestones Data
                const milestones = ref([
                    { id: 1, title: 'Milestone 1: Đề xuất & Thiết kế UI/UX', description: 'Nộp tài liệu thiết kế giao diện Figma và Wireframe.', dueDate: '2026-10-20', completionRate: 85, completed: false },
                    { id: 2, title: 'Milestone 2: Triển khai Backend RESTful APIs', description: 'Xây dựng cơ sở dữ liệu và hoàn thiện API endpoints.', dueDate: '2026-11-15', completionRate: 40, completed: false }
                ]);

                // Mock Student Checkpoints Data
                const studentCheckpoints = ref([
                    { id: 1, teamId: 1, teamCode: 'A1', teamName: 'Nhóm Alpha', className: 'SE101.O12', title: 'Checkpoint 1: Nộp sơ đồ DB Schema & Wireframe UI', dueDate: '2026-10-25', status: 'Submitted', submittedAt: '10:30 - 13/10/2026', submissionLink: 'https://github.com/alpha-team/project-docs', studentNotes: 'Đã hoàn thiện thiết kế ERD và Figma UI.', feedbackText: 'Sơ đồ DB rõ ràng. Cần bổ sung constraint cho khóa ngoại.', groupScore: 8.5, members: [{ id: 1, name: 'Trần Thị B', code: 'SV100248' }] }
                ]);
                const activeEvaluation = ref(studentCheckpoints.value[0]);
                const selectedMemberForEval = ref(1);
                const individualScore = ref(9.0);

                // Student UI Specific State
                const hasTeam = ref(true); // Toggle State A/B demo
                const isTeamLeader = ref(true);
                const studentTeam = ref({
                    id: 1, name: 'Nhóm Alpha', className: 'SE101.O12',
                    members: [
                        { id: 1, name: 'Trần Thị B', code: 'SV100248', email: 'tranb@student.edu.vn', role: 'Leader', avatar: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&auto=format&fit=crop&q=80' },
                        { id: 2, name: 'Lê Văn C', code: 'SV100249', email: 'levanc@student.edu.vn', role: 'Member', avatar: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=100&auto=format&fit=crop&q=80' }
                    ]
                });
                const recruitingTeams = ref([
                    { id: 2, name: 'Nhóm Delta', leader: 'Nguyễn Văn E', className: 'SE101.O12', slotsNeeded: 2 }
                ]);
                const studentProject = ref({ title: 'Hệ thống Quản lý Đồ án Sinh viên (EduProject)', status: 'Approved' });
                const availableStudentProjects = ref([
                    { id: 1, title: 'Hệ thống Quản lý Đồ án Sinh viên (EduProject)', description: 'Xây dựng web app hỗ trợ làm đồ án nhóm.', category: 'Web App', status: 'Approved' },
                    { id: 2, title: 'Ứng dụng Chat Bot Hỗ trợ Học tập AI', description: 'Chatbot tự động trả lời câu hỏi môn học.', category: 'AI', status: null }
                ]);

                // Student Tasks (Kanban) Data
                const tasks = ref([
                    { id: 1, title: 'Vẽ sơ đồ ERD cho cơ sở dữ liệu', assignee: 'Trần Thị B', dueDate: '2026-10-18', column: 'Done' },
                    { id: 2, title: 'Thiết kế giao diện Task Board bằng Tailwind', assignee: 'Trần Thị B', dueDate: '2026-10-22', column: 'In Progress' },
                    { id: 3, title: 'Viết API POST /checkpoints/{id}/submit', assignee: 'Lê Văn C', dueDate: '2026-10-25', column: 'To Do' }
                ]);
                const myAssignedTasks = computed(() => tasks.value.filter(t => t.assignee === 'Trần Thị B'));

                // AI Chat State
                const aiMessages = ref([
                    { id: 1, sender: 'bot', text: 'Xin chào! Tôi là AI Co-pilot hỗ trợ quản lý đồ án. Hãy chọn hoặc nhập yêu cầu bên dưới.' }
                ]);
                const aiInput = ref('');

                // Submission Modal Input Temp
                const submissionInputLink = ref('');
                const submissionInputNotes = ref('');

                // Helper Functions
                const navClass = (tabName) => {
                    return currentTab.value === tabName 
                        ? 'bg-sky-600/20 text-sky-400 font-bold border border-sky-500/30' 
                        : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50';
                };

                const switchRole = (role) => {
                    currentRole.value = role;
                    currentTab.value = role === 'lecturer' ? 'lecturer-dashboard' : 'student-dashboard';
                    triggerApiLog('GET', `/user/profile?role=${role}`, null);
                };

                const triggerApiLog = (method, url, payload) => {
                    apiLog.value = { method, url, payload };
                    setTimeout(() => { if (apiLog.value?.url === url) apiLog.value = null; }, 4000);
                };

                // API Action Simulations
                const approveProject = (id) => {
                    pendingProjects.value = pendingProjects.value.filter(p => p.id !== id);
                    triggerApiLog('POST', `/projects/${id}/approve`, { status: 'APPROVED' });
                };

                const denyProject = (id) => {
                    pendingProjects.value = pendingProjects.value.filter(p => p.id !== id);
                    triggerApiLog('POST', `/projects/${id}/deny`, { status: 'DENIED' });
                };

                const submitCheckpointFeedback = (id) => {
                    triggerApiLog('POST', `/checkpoints/${id}/feedback`, { feedback: activeEvaluation.value.feedbackText });
                };

                const markCheckpointComplete = (id) => {
                    if (activeEvaluation.value) activeEvaluation.value.status = 'Evaluated';
                    triggerApiLog('PATCH', `/checkpoints/${id}/complete`, { completed: true });
                };

                const submitGroupEvaluation = (teamId) => {
                    triggerApiLog('POST', `/teams/${teamId}/evaluations`, { groupScore: activeEvaluation.value.groupScore });
                };

                const submitIndividualEvaluation = (memberId) => {
                    triggerApiLog('POST', `/members/${memberId}/evaluations`, { score: individualScore.value });
                };

                const toggleMilestoneComplete = (id) => {
                    const ms = milestones.value.find(m => m.id === id);
                    if (ms) ms.completed = !ms.completed;
                    triggerApiLog('PATCH', `/milestones/${id}/complete`, { completed: ms?.completed });
                };

                const updateMilestoneDeadline = (id, newDate) => {
                    const ms = milestones.value.find(m => m.id === id);
                    if (ms) ms.dueDate = newDate;
                    triggerApiLog('PUT', `/milestones/${id}`, { dueDate: newDate });
                };

                // Kanban Helpers
                const getTasksByColumn = (colName) => tasks.value.filter(t => t.column === colName);
                const moveTask = (taskId, newCol) => {
                    const t = tasks.value.find(item => item.id === taskId);
                    if (t) {
                        t.column = newCol;
                        triggerApiLog('PUT', `/tasks/${taskId}`, { column: newCol });
                    }
                };
                const deleteTask = (taskId) => {
                    tasks.value = tasks.value.filter(t => t.id !== taskId);
                    triggerApiLog('DELETE', `/tasks/${taskId}`, null);
                };

                // Student Actions
                const openSubmitModal = (cp) => {
                    showSubmitModal.value = true;
                };
                const submitCheckpointApi = () => {
                    showSubmitModal.value = false;
                    triggerApiLog('POST', `/checkpoints/1/submit`, { link: submissionInputLink.value, notes: submissionInputNotes.value });
                };
                const registerProject = (projId) => {
                    const p = availableStudentProjects.value.find(x => x.id === projId);
                    if (p) p.status = 'Pending';
                    triggerApiLog('POST', `/projects/${projId}/submit`, { teamId: studentTeam.value.id });
                };

                // AI Co-pilot Logic
                const triggerAiPrompt = (prompt) => {
                    aiMessages.value.push({ id: Date.now(), sender: 'user', text: prompt });
                    setTimeout(() => {
                        let botReply = "Đã ghi nhận yêu cầu. AI đang phân tích dữ liệu môn học...";
                        if (prompt.includes('Syllabus')) botReply = "AI Gợi ý Syllabus: Đề xuất chia 4 Checkpoints chính tập trung vào UI/UX (Tuần 4), System Design (Tuần 7), Core APIs (Tuần 10) và Final Demo.";
                        if (prompt.includes('Tasks')) botReply = "AI đã phân rã Milestone 1 thành 3 sub-tasks: 1) Vẽ Wireframe Figma, 2) Thiết kế Database ERD, 3) Tạo repository GitHub.";
                        if (prompt.includes('tiến độ')) botReply = "Tiến độ nhóm Alpha đang đạt 75%, đáp ứng đúng thời hạn cho Checkpoint tiếp theo.";
                        aiMessages.value.push({ id: Date.now() + 1, sender: 'bot', text: botReply });
                    }, 600);
                };

                const sendAiMessage = () => {
                    if (!aiInput.value.trim()) return;
                    triggerAiPrompt(aiInput.value);
                    aiInput.value = '';
                };

                // Simple Modals Trigger Placeholders
                const openCreateSubjectModal = () => triggerApiLog('POST', '/subjects', { name: 'Môn học mới' });
                const openCreateClassModal = () => triggerApiLog('POST', '/classes', { code: 'SE102.O11' });
                const openImportStudentsModal = () => triggerApiLog('POST', `/classes/${selectedClass.value.id}/students`, { list: ['SV100251', 'SV100252'] });
                const openAddCoLecturerModal = () => triggerApiLog('POST', `/classes/${selectedClass.value.id}/lecturer`, { lecturerId: 102 });
                const openCreateProjectModal = () => triggerApiLog('POST', '/projects', { title: 'Đề tài mẫu mới' });
                const openAssignClassModal = (proj) => triggerApiLog('POST', `/projects/${proj.id}/assign-class`, { classId: 1 });
                const openCreateMilestoneModal = () => triggerApiLog('POST', '/projects/1/milestones', { title: 'Milestone Mới' });
                const openCreateCheckpointModal = () => triggerApiLog('POST', '/teams/1/checkpoints', { title: 'Checkpoint Mới' });
                const openCreateTeamModal = () => { hasTeam.value = true; triggerApiLog('POST', '/teams', { name: 'Nhóm Mới Tạo' }); };
                const openAddMemberModal = () => triggerApiLog('POST', `/teams/${studentTeam.value.id}/members`, { studentCode: 'SV100299' });
                const removeTeamMember = (mId) => triggerApiLog('DELETE', `/teams/${studentTeam.value.id}/members/${mId}`, null);
                const joinTeamRequest = (tId) => triggerApiLog('POST', `/teams/${tId}/join-request`, null);
                const openProposeProjectModal = () => triggerApiLog('POST', '/projects', { title: 'Đề xuất bởi SV' });
                const openCreateTaskModal = () => {
                    tasks.value.push({ id: Date.now(), title: 'Task Mới Tạo', assignee: 'Trần Thị B', dueDate: '2026-10-30', column: 'To Do' });
                    triggerApiLog('POST', `/teams/1/tasks`, { title: 'Task Mới Tạo' });
                };
                const viewSyllabus = (subj) => { viewSyllabusModal.value = true; };
                const openEvaluationView = (cp) => { activeEvaluation.value = cp; currentTab.value = 'lecturer-evaluations'; };
                const toggleNotifications = () => { showNotifications.value = !showNotifications.value; };
                const clearNotifications = () => { notifications.value = []; showNotifications.value = false; };

                return {
                    currentRole, currentTab, currentUser, navClass, switchRole,
                    showNotifications, notifications, unreadNotificationsCount, toggleNotifications, clearNotifications,
                    subjects, classes, selectedClass, classActiveTab,
                    projectPool, pendingProjects, projectPoolTab: ref('pool'),
                    milestones, studentCheckpoints, activeEvaluation, selectedMemberForEval, individualScore,
                    hasTeam, isTeamLeader, studentTeam, recruitingTeams, studentProject, availableStudentProjects,
                    tasks, myAssignedTasks, getTasksByColumn, moveTask, deleteTask,
                    aiDrawerOpen, aiMessages, aiInput, triggerAiPrompt, sendAiMessage,
                    viewSyllabusModal, viewSyllabus, showSubmitModal, openSubmitModal, submitCheckpointApi,
                    submissionInputLink, submissionInputNotes, apiLog,
                    approveProject, denyProject, submitCheckpointFeedback, markCheckpointComplete,
                    submitGroupEvaluation, submitIndividualEvaluation, toggleMilestoneComplete, updateMilestoneDeadline,
