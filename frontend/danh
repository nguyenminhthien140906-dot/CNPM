<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-900 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduProject Hub - Academic Project Management System</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Custom scrollbars */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
        ::-webkit-scrollbar-thumb { background: rgba(51, 65, 85, 0.8); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(71, 85, 105, 1); }
        .glass-panel { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .kanban-column { min-height: 400px; }
    </style>
</head>
<body class="h-full overflow-hidden bg-slate-950 text-slate-100 flex flex-col">

    <div id="app" class="h-full flex flex-col relative overflow-hidden">

        <header class="h-16 bg-slate-900/90 border-b border-slate-800 px-4 flex items-center justify-between shrink-0 z-20">
            <!-- Brand & App Name -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-sky-500/20">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg text-white tracking-wide leading-none flex items-center gap-2">
                        EduProject <span class="text-xs px-2 py-0.5 rounded bg-sky-500/20 text-sky-400 font-semibold border border-sky-500/30">Hub</span>
                    </h1>
                    <p class="text-xs text-slate-400 mt-0.5">Hệ thống Quản lý Đồ án & Dự án Sinh viên</p>
                </div>
            </div>

            <!-- Header Action Controls -->
            <div class="flex items-center gap-4">

                <!-- Role Switcher Toggle -->
                <div class="flex items-center bg-slate-800 p-1 rounded-lg border border-slate-700">
                    <button @click="switchRole('lecturer')" 
                            :class="currentRole === 'lecturer' ? 'bg-sky-600 text-white shadow-md' : 'text-slate-400 hover:text-slate-200'" 
                            class="px-3 py-1.5 rounded-md text-xs font-semibold transition-all flex items-center gap-2">
                        <i class="fa-solid fa-user-tie"></i>
                        <span>Giảng viên</span>
                    </button>
                    <button @click="switchRole('student')" 
                            :class="currentRole === 'student' ? 'bg-emerald-600 text-white shadow-md' : 'text-slate-400 hover:text-slate-200'" 
                            class="px-3 py-1.5 rounded-md text-xs font-semibold transition-all flex items-center gap-2">
                        <i class="fa-solid fa-user-graduate"></i>
                        <span>Sinh viên</span>
                    </button>
                </div>

                <!-- Notifications Button -->
                <div class="relative">
                    <button @click="toggleNotifications" class="relative p-2 text-slate-400 hover:text-white bg-slate-800/80 hover:bg-slate-800 rounded-lg border border-slate-700/80 transition-colors">
                        <i class="fa-regular fa-bell text-lg"></i>
                        <span v-if="unreadNotificationsCount > 0" class="absolute -top-1 -right-1 w-5 h-5 bg-rose-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center animate-pulse">
                            {{ unreadNotificationsCount }}
                        </span>
                    </button>

                    <!-- Notifications Dropdown Drawer -->
                    <div v-if="showNotifications" class="absolute right-0 mt-2 w-80 sm:w-96 glass-panel rounded-xl shadow-2xl border border-slate-700 py-3 z-50">
                        <div class="px-4 pb-2 border-b border-slate-700/60 flex items-center justify-between">
                            <h3 class="font-semibold text-sm text-slate-200 flex items-center gap-2">
                                <i class="fa-solid fa-bell text-sky-400"></i> Thông báo Realtime
                            </h3>
                            <button @click="clearNotifications" class="text-xs text-sky-400 hover:underline">Đánh dấu đã đọc</button>
                        </div>
                        <div class="max-h-80 overflow-y-auto divide-y divide-slate-800">
                            <div v-for="notif in notifications" :key="notif.id" class="p-3 hover:bg-slate-800/50 transition-colors flex gap-3">
                                <div class="mt-0.5">
                                    <span v-if="notif.type==='approve'" class="w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs"><i class="fa-solid fa-check"></i></span>
                                    <span v-else-if="notif.type==='submission'" class="w-7 h-7 rounded-full bg-sky-500/20 text-sky-400 flex items-center justify-center text-xs"><i class="fa-solid fa-file-arrow-up"></i></span>
                                    <span v-else class="w-7 h-7 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-xs"><i class="fa-solid fa-comment-dots"></i></span>
                                </div>
                                <div class="flex-1">
                                    <p class="text-xs text-slate-200 leading-snug">{{ notif.message }}</p>
                                    <span class="text-[10px] text-slate-400 mt-1 block">{{ notif.time }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Profile Summary -->
                <div class="flex items-center gap-3 pl-3 border-l border-slate-800">
                    <img :src="currentUser.avatar" class="w-9 h-9 rounded-full border border-sky-500/40 object-cover" alt="User Avatar">
                    <div class="hidden sm:block text-left">
                        <div class="text-xs font-semibold text-slate-200">{{ currentUser.name }}</div>
                        <div class="text-[10px] text-slate-400">{{ currentUser.roleTitle }}</div>
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 flex overflow-hidden">

            <!-- SIDEBAR NAVIGATION -->
            <aside class="w-64 bg-slate-900/60 border-r border-slate-800 flex flex-col shrink-0">
                
                <!-- Role Status Banner -->
                <div class="p-4 border-b border-slate-800/80">
                    <div class="text-[11px] font-semibold tracking-wider text-slate-400 uppercase">Chế độ đang dùng</div>
                    <div class="mt-1 flex items-center justify-between">
                        <span class="font-bold text-sm" :class="currentRole === 'lecturer' ? 'text-sky-400' : 'text-emerald-400'">
                            <i :class="currentRole === 'lecturer' ? 'fa-solid fa-chalkboard-user' : 'fa-solid fa-user-graduate'" class="mr-1.5"></i>
                            {{ currentRole === 'lecturer' ? 'Giảng viên' : 'Sinh viên' }}
                        </span>
                        <span class="px-2 py-0.5 text-[10px] rounded-full font-bold uppercase tracking-wider" 
                              :class="currentRole === 'lecturer' ? 'bg-sky-500/20 text-sky-300 border border-sky-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'">
                            Active
                        </span>
                    </div>
                </div>

                <!-- Navigation Links for LECTURER -->
                <nav v-if="currentRole === 'lecturer'" class="flex-1 p-3 space-y-1 overflow-y-auto">
                    <button @click="currentTab = 'lecturer-dashboard'" :class="navClass('lecturer-dashboard')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-chart-pie w-4 text-center"></i>
                        <span>Dashboard</span>
                    </button>
                    <button @click="currentTab = 'lecturer-subjects'" :class="navClass('lecturer-subjects')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-book w-4 text-center"></i>
                        <span>Môn học & Syllabus</span>
                    </button>
                    <button @click="currentTab = 'lecturer-classes'" :class="navClass('lecturer-classes')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-users-rectangle w-4 text-center"></i>
                        <span>Lớp học</span>
                    </button>
                    <button @click="currentTab = 'lecturer-projects'" :class="navClass('lecturer-projects')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center justify-between transition-colors">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-folder-tree w-4 text-center"></i>
                            <span>Đề tài & Dự án</span>
                        </div>
                        <span v-if="pendingProjects.length > 0" class="px-2 py-0.5 bg-amber-500/20 text-amber-300 text-[10px] font-bold rounded-full border border-amber-500/30">
                            {{ pendingProjects.length }}
                        </span>
                    </button>
                    <button @click="currentTab = 'lecturer-milestones'" :class="navClass('lecturer-milestones')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-flag w-4 text-center"></i>
                        <span>Cột mốc & Checkpoint</span>
                    </button>
                    <button @click="currentTab = 'lecturer-evaluations'" :class="navClass('lecturer-evaluations')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-clipboard-check w-4 text-center"></i>
                        <span>Chấm điểm & Đánh giá</span>
                    </button>
                </nav>

                <!-- Navigation Links for STUDENT -->
                <nav v-else class="flex-1 p-3 space-y-1 overflow-y-auto">
                    <button @click="currentTab = 'student-dashboard'" :class="navClass('student-dashboard')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-house w-4 text-center"></i>
                        <span>Dashboard</span>
                    </button>
                    <button @click="currentTab = 'student-classes'" :class="navClass('student-classes')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-graduation-cap w-4 text-center"></i>
                        <span>Lớp học của tôi</span>
                    </button>
                    <button @click="currentTab = 'student-team'" :class="navClass('student-team')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center justify-between transition-colors">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-people-group w-4 text-center"></i>
                            <span>Nhóm của tôi</span>
                        </div>
                        <span class="text-[10px] px-1.5 py-0.5 rounded font-bold" :class="hasTeam ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-700 text-slate-400'">
                            {{ hasTeam ? 'Đã có nhóm' : 'Chưa có nhóm' }}
                        </span>
                    </button>
                    <button @click="currentTab = 'student-projects'" :class="navClass('student-projects')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-lightbulb w-4 text-center"></i>
                        <span>Đăng ký / Đề xuất Đề tài</span>
                    </button>
                    <button @click="currentTab = 'student-tasks'" :class="navClass('student-tasks')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-list-check w-4 text-center"></i>
                        <span>Task Board (Kanban)</span>
                    </button>
                    <button @click="currentTab = 'student-checkpoints'" :class="navClass('student-checkpoints')" class="w-full text-left px-3.5 py-2.5 rounded-lg text-xs font-medium flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-cloud-arrow-up w-4 text-center"></i>
                        <span>Nộp bài Checkpoint</span>
                    </button>
                </nav>

                <!-- Footer Info Area -->
                <div class="p-3 border-t border-slate-800/80 bg-slate-900/40 text-[11px] text-slate-400 flex items-center justify-between">
                    <span>Học kỳ 1 - 2026/2027</span>
                    <span class="inline-flex items-center gap-1 text-emerald-400"><i class="fa-solid fa-circle text-[8px]"></i> Realtime Active</span>
                </div>
            </aside>

            <!-- MAIN CONTENT DISPLAY AREA -->
            <main class="flex-1 bg-slate-950 overflow-y-auto p-6 relative">

                
                <!-- 1. LECTURER DASHBOARD -->
                <div v-if="currentTab === 'lecturer-dashboard'" class="space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-white">Tổng quan Giảng viên</h2>
                            <p class="text-xs text-slate-400 mt-1">Chào mừng trở lại, Tiến sĩ Nguyễn Văn A. Dưới đây là tóm tắt tiến độ lớp học.</p>
                        </div>
                        <div class="flex gap-2">
                            <button @click="currentTab='lecturer-projects'" class="px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-medium flex items-center gap-2 transition-colors">
                                <i class="fa-solid fa-plus"></i> Duyệt Đề Tài Mới
                            </button>
                        </div>
                    </div>

                    <!-- Stats Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="glass-panel p-4 rounded-xl border-l-4 border-l-sky-500">
                            <div class="text-xs text-slate-400 font-medium">Lớp Phụ Trách</div>
                            <div class="text-2xl font-bold text-white mt-1">4 Lớp</div>
                            <div class="text-[11px] text-slate-400 mt-2"><i class="fa-solid fa-user-group text-sky-400"></i> Total 142 Sinh viên</div>
                        </div>
                        <div class="glass-panel p-4 rounded-xl border-l-4 border-l-amber-500">
                            <div class="text-xs text-slate-400 font-medium">Đề Tài Chờ Duyệt</div>
                            <div class="text-2xl font-bold text-amber-400 mt-1">{{ pendingProjects.length }} Yêu cầu</div>
                            <div class="text-[11px] text-slate-400 mt-2"><i class="fa-solid fa-clock text-amber-400"></i> Cần xử lý sớm</div>
                        </div>
                        <div class="glass-panel p-4 rounded-xl border-l-4 border-l-indigo-500">
                            <div class="text-xs text-slate-400 font-medium">Bài Nộp Checkpoint Mới</div>
                            <div class="text-2xl font-bold text-indigo-400 mt-1">8 Bài</div>
                            <div class="text-[11px] text-slate-400 mt-2"><i class="fa-solid fa-file-signature text-indigo-400"></i> Cần chấm & feedback</div>
                        </div>
                        <div class="glass-panel p-4 rounded-xl border-l-4 border-l-emerald-500">
                            <div class="text-xs text-slate-400 font-medium">Tỷ Lệ Hoàn Thành Đúng Hạn</div>
                            <div class="text-2xl font-bold text-emerald-400 mt-1">88.5%</div>
                            <div class="text-[11px] text-slate-400 mt-2"><i class="fa-solid fa-arrow-trend-up text-emerald-400"></i> +2.4% so với tuần trước</div>
                        </div>
                    </div>

                    <!-- Recent Activity & Checkpoint Queue -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-2 glass-panel p-5 rounded-xl border border-slate-800">
                            <h3 class="font-bold text-sm text-slate-200 mb-4 flex items-center justify-between">
                                <span><i class="fa-solid fa-list-check text-sky-400 mr-2"></i> Danh sách Checkpoint Chờ Chấm Score</span>
                                <button @click="currentTab='lecturer-evaluations'" class="text-xs text-sky-400 hover:underline">Xem tất cả</button>
                            </h3>
                            <div class="space-y-3">
                                <div v-for="cp in studentCheckpoints.filter(c => c.status === 'Submitted')" :key="cp.id" class="p-3 bg-slate-900/80 rounded-lg border border-slate-800 flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center font-bold text-xs">
                                            {{ cp.teamCode }}
                                        </div>
                                        <div>
                                            <div class="text-xs font-semibold text-slate-200">{{ cp.title }}</div>
                                            <div class="text-[11px] text-slate-400">Nhóm: <span class="text-slate-300 font-medium">{{ cp.teamName }}</span> • Lớp: {{ cp.className }}</div>
                                        </div>
                                    </div>
                                    <button @click="openEvaluationView(cp)" class="px-3 py-1.5 bg-sky-600/80 hover:bg-sky-600 text-white text-xs rounded-md transition-colors">
                                        Chấm điểm & Review
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Class Quick Stats -->
                        <div class="glass-panel p-5 rounded-xl border border-slate-800">
                            <h3 class="font-bold text-sm text-slate-200 mb-4"><i class="fa-solid fa-layer-group text-indigo-400 mr-2"></i> Trạng Thái Các Lớp</h3>
                            <div class="space-y-4">
                                <div v-for="cls in classes" :key="cls.id" class="p-3 bg-slate-900/60 rounded-lg border border-slate-800/80">
                                    <div class="flex items-center justify-between text-xs font-bold text-slate-200">
                                        <span>{{ cls.code }} - {{ cls.name }}</span>
                                        <span class="text-sky-400">{{ cls.studentsCount }} SV</span>
                                    </div>
                                    <div class="w-full bg-slate-800 h-2 rounded-full mt-2 overflow-hidden">
                                        <div class="bg-gradient-to-r from-sky-500 to-indigo-500 h-full" :style="{ width: cls.progress + '%' }"></div>
                                    </div>
                                    <div class="flex justify-between text-[10px] text-slate-400 mt-1">
                                        <span>Tiến độ chung: {{ cls.progress }}%</span>
                                        <span>{{ cls.teamsCount }} Nhóm</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. LECTURER: SUBJECTS & SYLLABUS (/subjects) -->
                <div v-if="currentTab === 'lecturer-subjects'" class="space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-white">Quản lý Môn học & Syllabus</h2>
                            <p class="text-xs text-slate-400 mt-1">Xem chi tiết chương trình môn học và cập nhật syllabus giảng dạy.</p>
                        </div>
                        <button @click="openCreateSubjectModal" class="px-3.5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition-colors">
                            <i class="fa-solid fa-plus"></i> Tạo môn học mới
                        </button>
                    </div>

                    <!-- Subjects Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                        <div v-for="subj in subjects" :key="subj.id" class="glass-panel rounded-xl p-5 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-all">
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <span class="px-2.5 py-1 bg-sky-500/10 text-sky-400 rounded text-xs font-bold border border-sky-500/20">{{ subj.code }}</span>
                                    <span class="text-xs text-slate-400"><i class="fa-solid fa-clock mr-1"></i> {{ subj.credits }} Tín chỉ</span>
                                </div>
                                <h3 class="font-bold text-base text-white mb-2">{{ subj.name }}</h3>
                                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">{{ subj.description }}</p>
                            </div>
                            <div class="mt-5 pt-4 border-t border-slate-800 flex items-center justify-between">
                                <span class="text-xs text-slate-400"><i class="fa-solid fa-book-open text-indigo-400 mr-1"></i> Syllabus v{{ subj.syllabusVersion }}</span>
                                <button @click="viewSyllabus(subj)" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5">
                                    <i class="fa-regular fa-eye"></i> Xem Syllabus
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. LECTURER: CLASSES MANAGEMENT (/classes) -->
                <div v-if="currentTab === 'lecturer-classes'" class="space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-white">Quản lý Lớp học</h2>
                            <p class="text-xs text-slate-400 mt-1">Quản lý danh sách lớp, import sinh viên và phân công giảng viên đồng phụ trách.</p>
                        </div>
                        <button @click="openCreateClassModal" class="px-3.5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition-colors">
                            <i class="fa-solid fa-plus"></i> Tạo lớp mới
                        </button>
                    </div>

                    <!-- Classes Cards & Detail Tab View -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Class Selection List -->
                        <div class="space-y-3">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Danh sách Lớp Học</h3>
                            <div v-for="cls in classes" :key="cls.id" 
                                 @click="selectedClass = cls"
                                 :class="selectedClass?.id === cls.id ? 'bg-sky-950/50 border-sky-500/50 shadow-md ring-1 ring-sky-500/30' : 'bg-slate-900/70 border-slate-800 hover:border-slate-700'"
                                 class="p-4 rounded-xl border cursor-pointer transition-all">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h4 class="font-bold text-sm text-slate-100">{{ cls.code }}</h4>
                                        <div class="text-xs text-slate-400 mt-0.5">{{ cls.name }}</div>
                                    </div>
                                    <span class="px-2 py-0.5 bg-slate-800 text-slate-300 text-[10px] font-semibold rounded">
                                        HK1-2026
                                    </span>
                                </div>
                                <div class="mt-3 flex items-center justify-between text-xs text-slate-400">
                                    <span><i class="fa-solid fa-users text-sky-400 mr-1"></i> {{ cls.students.length }} Sinh viên</span>
