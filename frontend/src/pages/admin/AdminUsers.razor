        z-index: 1000;
    }

    .modal-box {
        background: white;
        padding: 24px;
        border-radius: 12px;
        max-width: 420px;
        width: 90%;
        border: 1px solid #e2e8f0;
    }

    .modal-box h3 {
        color: #1e293b;
        margin-bottom: 10px;
    }

    .modal-box p {
        color: #475569;
        margin-bottom: 20px;
        line-height: 1.5;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    @media (max-width: 768px) {
        .statistics {
            grid-template-columns: repeat(2, 1fr);
        }

        .toolbar {
            flex-direction: column;
        }
    }
</style>
