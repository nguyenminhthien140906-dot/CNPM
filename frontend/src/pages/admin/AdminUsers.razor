
@page "/admin/users"

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@attribute [Authorize(Roles = "ADMIN")]
@inject HttpClient Http

<PageTitle>Quản lý tài khoản</PageTitle>

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>Quản lý tài khoản</h1>
            <p>Quản lý người dùng trong hệ thống CollabSphere.</p>
        </div>

        <button class="btn-primary" @onclick="OpenForm">
            + Thêm tài khoản
        </button>
    </div>

    <div class="statistics">
        <div class="stat-card">
            <span>Tổng tài khoản</span>
            <h2>@Users.Count</h2>
        </div>

        <div class="stat-card">
            <span>Admin</span>
            <h2>@CountRole("ADMIN")</h2>
        </div>

        <div class="stat-card">
            <span>Giảng viên</span>
            <h2>@CountRole("LECTURER")</h2>
        </div>

        <div class="stat-card">
            <span>Sinh viên</span>
            <h2>@CountRole("STUDENT")</h2>
        </div>
    </div>

    <div class="content-card">

        <div class="toolbar">
            <input type="text"
                   placeholder="Tìm kiếm tên hoặc email..."
                   @bind="SearchText"
                   @bind:event="oninput" />

            <select @bind="SelectedRole">
                <option value="">Tất cả vai trò</option>
                <option value="ADMIN">Admin</option>
                <option value="HEAD">Head</option>
                <option value="STAFF">Staff</option>
                <option value="LECTURER">Lecturer</option>
                <option value="STUDENT">Student</option>
            </select>

            <select @bind="SelectedStatus">
                <option value="">Tất cả trạng thái</option>
                <option value="Hoạt động">Hoạt động</option>
                <option value="Bị khóa">Bị khóa</option>
            </select>
        </div>

        @if (ShowForm)
        {
            <div class="form-card">
                <h3>@(IsEditMode ? "Cập nhật tài khoản" : "Thêm tài khoản mới")</h3>

                <label>Họ và tên</label>
                <input @bind="NewUser.FullName"
                       placeholder="Nhập họ và tên" />

                <label>Email</label>
                <input type="email"
                       @bind="NewUser.Email"
                       placeholder="Nhập email" />

                <label>Vai trò</label>
                <select @bind="NewUser.Role">
                    <option value="ADMIN">ADMIN</option>
                    <option value="HEAD">HEAD</option>
                    <option value="STAFF">STAFF</option>
                    <option value="LECTURER">LECTURER</option>
                    <option value="STUDENT">STUDENT</option>
                </select>

                <div class="form-actions">
                    <button class="btn-primary"
                            @onclick="SaveUser">
                        @(IsEditMode ? "Cập nhật" : "Lưu tài khoản")
                    </button>

                    <button class="btn-secondary"
                            @onclick="CloseForm">
                        Hủy
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <p class="error-message">@ErrorMessage</p>
                }
            </div>
        }

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in PagedUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>

                            <td>
                                <span class="role-badge">
                                    @user.Role
                                </span>
                            </td>

                            <td>
                                <span class="status-badge @(user.Status == "Hoạt động" ? "status-active" : "status-locked")">
                                    @user.Status
                                </span>
                            </td>

                            <td>
                                <div class="action-group">
                                    <button class="btn-edit"
                                            @onclick="() => OpenEditForm(user)">
                                        Sửa
                                    </button>

                                    <button class="@(user.Status == "Hoạt động" ? "btn-lock" : "btn-unlock")"
                                            @onclick='() => OpenConfirmModal(user, "TOGGLE_STATUS")'>
                                        @(user.Status == "Hoạt động" ? "Khóa" : "Mở khóa")
                                    </button>

                                    <button class="btn-delete"
                                            @onclick='() => OpenConfirmModal(user, "DELETE")'>
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!PagedUsers.Any())
                    {
                        <tr>
                            <td colspan="5" class="empty">
                                Không tìm thấy tài khoản.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (FilteredUsers.Any())
        {
            <div class="pagination">
                <span class="page-info">
                    Hiển thị @PagedUsers.Count() / @FilteredUsers.Count() tài khoản
                </span>

                <div class="page-controls">
                    <button class="page-btn"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="() => ChangePage(CurrentPage - 1)">
                        Trước
                    </button>

                    <span class="page-current">Trang @CurrentPage / @TotalPages</span>

                    <button class="page-btn"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="() => ChangePage(CurrentPage + 1)">
                        Sau
                    </button>
                </div>
            </div>
        }

    </div>

    @if (ShowConfirmModal && TargetUser != null)
    {
        <div class="modal-backdrop">
            <div class="modal-box">
                <h3>Xác nhận thao tác</h3>
                <p>
                    @if (ConfirmActionType == "DELETE")
                    {
                        <span>Bạn có chắc chắn muốn <strong>xóa</strong> tài khoản <strong>@TargetUser.FullName</strong> không?</span>
                    }
                    else
                    {
                        <span>
                            Bạn có chắc chắn muốn <strong>@(TargetUser.Status == "Hoạt động" ? "vô hiệu hóa" : "kích hoạt lại")</strong>
                            tài khoản <strong>@TargetUser.FullName</strong> không?
                        </span>
                    }
                </p>

                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="CloseConfirmModal">Hủy</button>
                    <button class="btn-delete" @onclick="ExecuteConfirmedAction">Xác nhận</button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string _searchText = "";
    private string SearchText
    {
        get => _searchText;
        set { _searchText = value; CurrentPage = 1; }
    }

    private string _selectedRole = "";
    private string SelectedRole
    {
        get => _selectedRole;
        set { _selectedRole = value; CurrentPage = 1; }
    }

    private string _selectedStatus = "";
    private string SelectedStatus
    {
        get => _selectedStatus;
        set { _selectedStatus = value; CurrentPage = 1; }
    }

    private bool ShowForm = false;
    private bool IsEditMode = false;
    private string ErrorMessage = "";

    private int CurrentPage = 1;
    private int PageSize = 5;

    private bool ShowConfirmModal = false;
    private string ConfirmActionType = "";
    private UserModel? TargetUser;

    private UserModel NewUser = new();

    private List<UserModel> Users = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiUsers = await Http.GetFromJsonAsync<List<UserModel>>("api/users");
            if (apiUsers != null && apiUsers.Any())
            {
                Users = apiUsers;
                return;
            }
        }
        catch
        {
            // Dùng dữ liệu mẫu bên dưới nếu API chưa kết nối
        }

        Users = new List<UserModel>
        {
            new() { Id = "1", FullName = "Nguyễn Văn An", Email = "an.nv@collabsphere.edu.vn", Role = "ADMIN", Status = "Hoạt động" },
            new() { Id = "2", FullName = "Trần Thị Bình", Email = "binh.tt@collabsphere.edu.vn", Role = "HEAD", Status = "Hoạt động" },
            new() { Id = "3", FullName = "Lê Hoàng Cường", Email = "cuong.lh@collabsphere.edu.vn", Role = "STAFF", Status = "Hoạt động" },
            new() { Id = "4", FullName = "Phạm Minh Dung", Email = "dung.pm@collabsphere.edu.vn", Role = "LECTURER", Status = "Hoạt động" },
            new() { Id = "5", FullName = "Nguyễn Trần Bảo Duy", Email = "duy.ntb@collabsphere.edu.vn", Role = "STUDENT", Status = "Hoạt động" },
            new() { Id = "6", FullName = "Hoàng Quốc Việt", Email = "viet.hq@collabsphere.edu.vn", Role = "STUDENT", Status = "Bị khóa" }
        };
    }

    private IEnumerable<UserModel> FilteredUsers =>
        Users.Where(user =>
            (string.IsNullOrWhiteSpace(SearchText) ||
             user.FullName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
             user.Email.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(SelectedRole) || user.Role == SelectedRole) &&
            (string.IsNullOrWhiteSpace(SelectedStatus) || user.Status == SelectedStatus)
        );

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredUsers.Count() / PageSize));

    private IEnumerable<UserModel> PagedUsers =>
        FilteredUsers.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private int CountRole(string role)
    {
        return Users.Count(user => user.Role == role);
    }

    private void OpenForm()
    {
        ErrorMessage = "";
        IsEditMode = false;
        NewUser = new UserModel();
        ShowForm = true;
    }

    private void OpenEditForm(UserModel user)
    {
        ErrorMessage = "";
        IsEditMode = true;
        NewUser = new UserModel
        {
            Id = user.Id,
            FullName = user.FullName,
            Email = user.Email,
            Role = user.Role,
            Status = user.Status
        };
        ShowForm = true;
    }

    private void CloseForm()
    {
        ShowForm = false;
        IsEditMode = false;
        ErrorMessage = "";
        NewUser = new UserModel();
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(NewUser.FullName) ||
            string.IsNullOrWhiteSpace(NewUser.Email))
        {
            ErrorMessage = "Vui lòng nhập đầy đủ thông tin.";
            return;
        }

        if (!NewUser.Email.Contains('@'))
        {
            ErrorMessage = "Email không hợp lệ.";
            return;
        }

        if (Users.Any(x => x.Id != NewUser.Id &&
            x.Email.Equals(NewUser.Email.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            ErrorMessage = "Email đã tồn tại.";
            return;
        }

        if (IsEditMode)
        {
            try
            {
                await Http.PutAsJsonAsync($"api/users/{NewUser.Id}", NewUser);
            }
            catch { }

            var existing = Users.FirstOrDefault(x => x.Id == NewUser.Id);
            if (existing != null)
            {
                existing.FullName = NewUser.FullName.Trim();
                existing.Email = NewUser.Email.Trim();
                existing.Role = NewUser.Role;
            }
        }
        else
        {
            var createdUser = new UserModel
            {
                Id = Guid.NewGuid().ToString("N")[..6].ToUpper(),
                FullName = NewUser.FullName.Trim(),
                Email = NewUser.Email.Trim(),
                Role = NewUser.Role,
                Status = "Hoạt động"
            };

            try
            {
                await Http.PostAsJsonAsync("api/users", createdUser);
            }
            catch { }

            Users.Add(createdUser);
        }

        CloseForm();
    }

    private void OpenConfirmModal(UserModel user, string actionType)
    {
        TargetUser = user;
        ConfirmActionType = actionType;
        ShowConfirmModal = true;
    }

    private void CloseConfirmModal()
    {
        ShowConfirmModal = false;
        TargetUser = null;
        ConfirmActionType = "";
    }

    private async Task ExecuteConfirmedAction()
    {
        if (TargetUser == null) return;

        if (ConfirmActionType == "DELETE")
        {
            try
            {
                await Http.DeleteAsync($"api/users/{TargetUser.Id}");
            }
            catch { }

            Users.Remove(TargetUser);
            if (CurrentPage > TotalPages) CurrentPage = TotalPages;
        }
        else if (ConfirmActionType == "TOGGLE_STATUS")
        {
            bool nextActive = TargetUser.Status != "Hoạt động";
            try
            {
                await Http.PatchAsJsonAsync($"api/users/{TargetUser.Id}/status", new { isActive = nextActive });
            }
            catch { }

            TargetUser.Status = nextActive ? "Hoạt động" : "Bị khóa";
        }

        CloseConfirmModal();
    }

    public class UserModel
    {
        public string Id { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "STUDENT";
        public string Status { get; set; } = "Hoạt động";
    }
}

<style>
    .page-container {
        padding: 28px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .page-header h1 {
        font-size: 26px;
        color: #1e293b;
    }

    .page-header p {
        color: #64748b;
    }

    .statistics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card, .content-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .stat-card span {
        color: #64748b;
    }

    .stat-card h2 {
        color: #2563eb;
        font-size: 28px;
    }

    .toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;
    }

    input, select {
        padding: 11px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
    }

    .toolbar input {
        flex: 1;
    }

    .btn-primary, .btn-secondary, .btn-delete, .btn-edit, .btn-lock, .btn-unlock {
        padding: 10px 16px;
        border: none;
        border-radius: 7px;
        cursor: pointer;
    }

    .btn-primary {
        background: #2563eb;
        color: white;
    }

    .btn-secondary {
        background: #e2e8f0;
    }

    .btn-edit {
        background: #e0f2fe;
        color: #0369a1;
    }

    .btn-lock {
        background: #fef3c7;
        color: #b45309;
    }

    .btn-unlock {
        background: #dcfce7;
        color: #15803d;
    }

    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
    }

    .action-group {
        display: flex;
        gap: 8px;
    }

    .form-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 500px;
        margin-bottom: 25px;
        padding: 20px;
        background: #f8fafc;
        border-radius: 10px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
    }

    .error-message {
        color: #dc2626;
    }

    .role-badge {
        padding: 5px 10px;
        background: #dbeafe;
        color: #1d4ed8;
        border-radius: 20px;
    }

    .status-badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-locked {
        background: #fee2e2;
        color: #dc2626;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #e2e8f0;
    }

    th {
        color: #475569;
        background: #f8fafc;
    }

    .empty {
        text-align: center;
        color: #94a3b8;
    }

    .pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }

    .page-info {
        color: #64748b;
        font-size: 14px;
    }

    .page-controls {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .page-current {
        color: #334155;
        font-size: 14px;
        font-weight: 500;
    }

    .page-btn {
        padding: 8px 14px;
        border: 1px solid #cbd5e1;
        background: white;
        color: #334155;
        border-radius: 7px;
        cursor: pointer;
    }

    .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
