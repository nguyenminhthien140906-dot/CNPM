
@page "/admin/users"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMIN")]

<PageTitle>Quản lý tài khoản</PageTitle>

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>Quản lý tài khoản</h1>
            <p>Quản lý người dùng trong hệ thống CollabSphere.</p>
        </div>

        <button class="btn-primary" @onclick="OpenForm">
            + Thêm tài khoản
        </button>
    </div>

    <div class="statistics">
        <div class="stat-card">
            <span>Tổng tài khoản</span>
            <h2>@Users.Count</h2>
        </div>

        <div class="stat-card">
            <span>Admin</span>
            <h2>@CountRole("ADMIN")</h2>
        </div>

        <div class="stat-card">
            <span>Giảng viên</span>
            <h2>@CountRole("LECTURER")</h2>
        </div>

        <div class="stat-card">
            <span>Sinh viên</span>
            <h2>@CountRole("STUDENT")</h2>
        </div>
    </div>

    <div class="content-card">

        <div class="toolbar">
            <input type="text"
                   placeholder="Tìm kiếm tên hoặc email..."
                   @bind="SearchText"
                   @bind:event="oninput" />

            <select @bind="SelectedRole">
                <option value="">Tất cả vai trò</option>
                <option value="ADMIN">Admin</option>
                <option value="HEAD">Head</option>
                <option value="STAFF">Staff</option>
                <option value="LECTURER">Lecturer</option>
                <option value="STUDENT">Student</option>
            </select>
        </div>

        @if (ShowForm)
        {
            <div class="form-card">
                <h3>Thêm tài khoản mới</h3>

                <label>Họ và tên</label>
                <input @bind="NewUser.FullName"
                       placeholder="Nhập họ và tên" />

                <label>Email</label>
                <input type="email"
                       @bind="NewUser.Email"
                       placeholder="Nhập email" />

                <label>Vai trò</label>
                <select @bind="NewUser.Role">
                    <option value="ADMIN">ADMIN</option>
                    <option value="HEAD">HEAD</option>
                    <option value="STAFF">STAFF</option>
                    <option value="LECTURER">LECTURER</option>
                    <option value="STUDENT">STUDENT</option>
                </select>

                <div class="form-actions">
                    <button class="btn-primary"
                            @onclick="AddUser">
                        Lưu tài khoản
                    </button>

                    <button class="btn-secondary"
                            @onclick="CloseForm">
                        Hủy
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <p class="error-message">@ErrorMessage</p>
                }
            </div>
        }

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in FilteredUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>

                            <td>
                                <span class="role-badge">
                                    @user.Role
                                </span>
                            </td>

                            <td>@user.Status</td>

                            <td>
                                <button class="btn-delete"
                                        @onclick="() => DeleteUser(user)">
                                    Xóa
                                </button>
                            </td>
                        </tr>
                    }

                    @if (!FilteredUsers.Any())
                    {
                        <tr>
                            <td colspan="5" class="empty">
                                Không tìm thấy tài khoản.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

@code {
    private string SearchText = "";
    private string SelectedRole = "";

    private bool ShowForm = false;
    private string ErrorMessage = "";

    private UserModel NewUser = new();

    private List<UserModel> Users = new();

    private IEnumerable<UserModel> FilteredUsers =>
        Users.Where(user =>
            (string.IsNullOrWhiteSpace(SearchText) ||
             user.FullName.Contains(
                 SearchText,
                 StringComparison.OrdinalIgnoreCase
             ) ||
             user.Email.Contains(
                 SearchText,
                 StringComparison.OrdinalIgnoreCase
             )) &&
            (string.IsNullOrWhiteSpace(SelectedRole) ||
             user.Role == SelectedRole)
        );

    private int CountRole(string role)
    {
        return Users.Count(user => user.Role == role);
    }

    private void OpenForm()
    {
        ErrorMessage = "";
        NewUser = new UserModel();
        ShowForm = true;
    }

    private void CloseForm()
    {
        ShowForm = false;
        ErrorMessage = "";
        NewUser = new UserModel();
    }

    private void AddUser()
    {
        if (string.IsNullOrWhiteSpace(NewUser.FullName) ||
            string.IsNullOrWhiteSpace(NewUser.Email))
        {
            ErrorMessage = "Vui lòng nhập đầy đủ thông tin.";
            return;
        }

        if (!NewUser.Email.Contains('@'))
        {
            ErrorMessage = "Email không hợp lệ.";
            return;
        }

        if (Users.Any(x => x.Email.Equals(
            NewUser.Email,
            StringComparison.OrdinalIgnoreCase)))
        {
            ErrorMessage = "Email đã tồn tại.";
            return;
        }

        Users.Add(new UserModel
        {
            FullName = NewUser.FullName.Trim(),
            Email = NewUser.Email.Trim(),
            Role = NewUser.Role,
            Status = "Hoạt động"
        });

        CloseForm();
    }

    private void DeleteUser(UserModel user)
    {
        Users.Remove(user);
    }

    public class UserModel
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "STUDENT";
        public string Status { get; set; } = "Hoạt động";
    }
}

<style>
    .page-container {
        padding: 28px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .page-header h1 {
        font-size: 26px;
        color: #1e293b;
    }

    .page-header p {
        color: #64748b;
    }

    .statistics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card, .content-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .stat-card span {
        color: #64748b;
    }

    .stat-card h2 {
        color: #2563eb;
        font-size: 28px;
    }

    .toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;
    }

    input, select {
        padding: 11px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
    }

    .toolbar input {
        flex: 1;
    }

    .btn-primary, .btn-secondary, .btn-delete {
        padding: 10px 16px;
        border: none;
        border-radius: 7px;
        cursor: pointer;
    }

    .btn-primary {
        background: #2563eb;
        color: white;
    }

    .btn-secondary {
        background: #e2e8f0;
    }

    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
    }

    .form-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 500px;
        margin-bottom: 25px;
        padding: 20px;
        background: #f8fafc;
        border-radius: 10px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
    }

    .error-message {
        color: #dc2626;
    }

    .role-badge {
        padding: 5px 10px;
        background: #dbeafe;
        color: #1d4ed8;
        border-radius: 20px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #e2e8f0;
    }

    th {
        color: #475569;
        background: #f8fafc;
    }

    .empty {
        text-align: center;
        color: #94a3b8;
    }

    @media (max-width: 768px) {
        .statistics {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
