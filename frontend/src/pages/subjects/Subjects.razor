@page "/subjects"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Quản lý môn học</PageTitle>

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>Quản lý môn học</h1>
            <p>Quản lý thông tin môn học và chương trình đào tạo.</p>
        </div>

        <div class="header-actions">
            <a href="/syllabus" class="btn-secondary link-btn">
                Quản lý Syllabus →
            </a>

            <button class="btn-primary" @onclick="OpenCreateForm">
                + Thêm môn học
            </button>
        </div>
    </div>

    <div class="statistics">

        <div class="stat-card">
            <span>Tổng môn học</span>
            <h2>@Subjects.Count</h2>
        </div>

        <div class="stat-card">
            <span>Đang hoạt động</span>
            <h2>@Subjects.Count(x => x.Status == "ACTIVE")</h2>
        </div>

        <div class="stat-card">
            <span>Ngừng hoạt động</span>
            <h2>@Subjects.Count(x => x.Status == "INACTIVE")</h2>
        </div>

    </div>

    <div class="content-card">

        <div class="toolbar">
            <input placeholder="Tìm kiếm mã môn hoặc tên môn..."
                   @bind="SearchText"
                   @bind:event="oninput" />

            <select @bind="SelectedStatus">
                <option value="">Tất cả trạng thái</option>
                <option value="ACTIVE">Đang hoạt động</option>
                <option value="INACTIVE">Ngừng hoạt động</option>
            </select>
        </div>

        @if (ShowForm)
        {
            <div class="form-card">

                <h3>@(EditingSubject == null ? "Thêm môn học mới" : "Chỉnh sửa môn học")</h3>

                <div class="form-group">
                    <label>Mã môn học</label>
                    <input @bind="FormData.SubjectCode"
                           placeholder="Ví dụ: CS101"
                           disabled="@(EditingSubject != null)" />
                </div>

                <div class="form-group">
                    <label>Tên môn học</label>
                    <input @bind="FormData.SubjectName"
                           placeholder="Nhập tên môn học" />
                </div>

                <div class="form-group">
                    <label>Số tín chỉ</label>
                    <input type="number"
                           min="1"
                           max="10"
                           @bind="FormData.Credits" />
                </div>

                <div class="form-group">
                    <label>Mô tả</label>
                    <textarea @bind="FormData.Description"
                              placeholder="Mô tả môn học">
                    </textarea>
                </div>

                <div class="form-group">
                    <label>Trạng thái</label>
                    <select @bind="FormData.Status">
                        <option value="ACTIVE">Đang hoạt động</option>
                        <option value="INACTIVE">Ngừng hoạt động</option>
                    </select>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <p class="error">@ErrorMessage</p>
                }

                <div class="form-actions">

                    <button class="btn-primary" @onclick="SaveSubject">
                        Lưu môn học
                    </button>

                    <button class="btn-secondary" @onclick="CloseForm">
                        Hủy
                    </button>

                </div>

            </div>
        }

        <div class="table-wrapper">

            <table>
                <thead>
                    <tr>
                        <th>Mã môn học</th>
                        <th>Tên môn học</th>
                        <th>Tín chỉ</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var subject in PagedSubjects)
                    {
                        <tr>
                            <td>@subject.SubjectCode</td>
                            <td>@subject.SubjectName</td>
                            <td>@subject.Credits</td>
                            <td>@subject.Description</td>
                            <td>
                                <span class="status-badge @(subject.Status == "ACTIVE" ? "active" : "inactive")">
                                    @GetStatusName(subject.Status)
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">

                                    <button class="btn-edit"
                                            @onclick="() => EditSubject(subject)">
                                        Sửa
                                    </button>

                                    <button class="btn-delete"
                                            @onclick="() => ConfirmDelete(subject)">
                                        Xóa
                                    </button>

                                </div>
                            </td>
                        </tr>
                    }

                    @if (!PagedSubjects.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty">
                                Không tìm thấy môn học.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

        @if (FilteredSubjects.Any())
        {
            <div class="pagination">
                <span class="page-info">
                    Hiển thị @PagedSubjects.Count() / @FilteredSubjects.Count() môn học
                </span>

                <div class="page-controls">
                    <button class="page-btn"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="() => ChangePage(CurrentPage - 1)">
                        Trước
                    </button>

                    <span class="page-current">Trang @CurrentPage / @TotalPages</span>

                    <button class="page-btn"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="() => ChangePage(CurrentPage + 1)">
                        Sau
                    </button>
                </div>
            </div>
        }

    </div>

    @if (SubjectToDelete != null)
    {
        <div class="modal-backdrop">
            <div class="modal-box">
                <h3>Xác nhận xóa môn học</h3>
                <p>
                    Bạn có chắc chắn muốn xóa môn học
                    <strong>@SubjectToDelete.SubjectCode - @SubjectToDelete.SubjectName</strong> không?
                </p>

                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="CancelDelete">Hủy</button>
                    <button class="btn-delete" @onclick="ExecuteDelete">Xác nhận xóa</button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string _searchText = "";
    private string SearchText
    {
        get => _searchText;
        set { _searchText = value; CurrentPage = 1; }
    }

    private string _selectedStatus = "";
    private string SelectedStatus
    {
        get => _selectedStatus;
        set { _selectedStatus = value; CurrentPage = 1; }
    }

    private bool ShowForm = false;
    private string ErrorMessage = "";

    private int CurrentPage = 1;
    private int PageSize = 5;

    private SubjectModel FormData = new();
    private SubjectModel? EditingSubject;
    private SubjectModel? SubjectToDelete;

    private List<SubjectModel> Subjects = new()
    {
        new()
        {
            SubjectCode = "CS101",
            SubjectName = "Lập trình cơ bản",
            Credits = 3,
            Description = "Kiến thức lập trình cơ bản.",
            Status = "ACTIVE"
        },
        new()
        {
            SubjectCode = "DB201",
            SubjectName = "Cơ sở dữ liệu",
            Credits = 3,
            Description = "Thiết kế và quản lý cơ sở dữ liệu.",
            Status = "ACTIVE"
        },
        new()
        {
            SubjectCode = "SE301",
            SubjectName = "Công nghệ phần mềm",
            Credits = 4,
            Description = "Phân tích và phát triển phần mềm.",
            Status = "ACTIVE"
        },
        new()
        {
            SubjectCode = "AI401",
            SubjectName = "Trí tuệ nhân tạo",
            Credits = 3,
            Description = "Nhập môn trí tuệ nhân tạo.",
            Status = "INACTIVE"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiSubjects = await Http.GetFromJsonAsync<List<SubjectModel>>("api/subjects");
            if (apiSubjects != null && apiSubjects.Any())
            {
                Subjects = apiSubjects;
            }
        }
        catch
        {
            // Giữ nguyên danh sách mẫu mặc định khi API chưa kết nối
        }
    }

    private IEnumerable<SubjectModel> FilteredSubjects =>
        Subjects.Where(subject =>
            (string.IsNullOrWhiteSpace(SearchText) ||
             subject.SubjectCode.Contains(
                 SearchText,
                 StringComparison.OrdinalIgnoreCase
             ) ||
             subject.SubjectName.Contains(
                 SearchText,
                 StringComparison.OrdinalIgnoreCase
             )) &&
            (string.IsNullOrWhiteSpace(SelectedStatus) ||
             subject.Status == SelectedStatus)
        );

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredSubjects.Count() / PageSize));

    private IEnumerable<SubjectModel> PagedSubjects =>
        FilteredSubjects.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void OpenCreateForm()
    {
        EditingSubject = null;
        FormData = new SubjectModel
        {
            Credits = 3,
            Status = "ACTIVE"
        };

        ErrorMessage = "";
        ShowForm = true;
    }

    private void EditSubject(SubjectModel subject)
    {
        EditingSubject = subject;

        FormData = new SubjectModel
        {
            SubjectCode = subject.SubjectCode,
            SubjectName = subject.SubjectName,
            Credits = subject.Credits,
            Description = subject.Description,
            Status = subject.Status
        };

        ErrorMessage = "";
        ShowForm = true;
    }

    private async Task SaveSubject()
    {
        if (string.IsNullOrWhiteSpace(FormData.SubjectCode) ||
            string.IsNullOrWhiteSpace(FormData.SubjectName))
        {
            ErrorMessage = "Vui lòng nhập mã môn và tên môn học.";
            return;
        }

        if (FormData.Credits < 1 || FormData.Credits > 10)
        {
            ErrorMessage = "Số tín chỉ phải từ 1 đến 10.";
            return;
        }

        if (EditingSubject == null)
        {
            bool codeExists = Subjects.Any(x =>
                x.SubjectCode.Equals(
                    FormData.SubjectCode.Trim(),
                    StringComparison.OrdinalIgnoreCase
                )
