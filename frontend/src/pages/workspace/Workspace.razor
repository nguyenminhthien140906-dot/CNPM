        border-radius: 12px;
    }

    .sidebar-card h3 {
        color: #1e293b;
        margin-bottom: 18px;
    }

    .member-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .member-avatar {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background: #dbeafe;
        color: #2563eb;
        font-weight: bold;
    }

    .member-item p {
        color: #94a3b8;
        font-size: 12px;
        margin-top: 4px;
    }

    .progress-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .progress-info strong {
        color: #2563eb;
        font-size: 24px;
    }

    .progress-info span {
        color: #64748b;
        font-size: 13px;
    }

    .progress-bar {
        height: 9px;
        background: #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-value {
        height: 100%;
        background: #2563eb;
    }

    .project-dates {
        margin-top: 15px;
        color: #64748b;
        font-size: 13px;
    }

    .checkpoint-item {
        padding: 12px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .checkpoint-item p {
        color: #64748b;
        font-size: 12px;
        margin: 7px 0;
    }

    .checkpoint-item span {
        color: #2563eb;
        font-size: 12px;
    }

    .empty {
        text-align: center;
        padding: 30px;
        color: #94a3b8;
    }

    @media(max-width: 1100px) {
        .workspace-grid {
            grid-template-columns: 1fr;
        }

        .sidebar {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media(max-width: 750px) {
        .statistics {
            grid-template-columns: repeat(2, 1fr);
        }

        .task-board {
            grid-template-columns: 1fr;
        }

        .sidebar {
            grid-template-columns: 1fr;
        }

        .workspace-header {
            flex-direction: column;
            align-items: stretch;
        }

        .project-banner {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
