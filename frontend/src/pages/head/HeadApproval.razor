
@page "/head/approval"

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@attribute [Authorize(Roles = "HEAD")]
@inject HttpClient Http

<PageTitle>Phê duyệt dự án</PageTitle>

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>Phê duyệt dự án</h1>
            <p>
                Xem xét và phê duyệt các dự án học tập
                được gửi từ giảng viên.
            </p>
        </div>
    </div>

    <div class="statistics">

        <div class="stat-card">
            <span>Chờ phê duyệt</span>
            <h2>@CountStatus("PENDING")</h2>
        </div>

        <div class="stat-card">
            <span>Đã phê duyệt</span>
            <h2>@CountStatus("APPROVED")</h2>
        </div>

        <div class="stat-card">
            <span>Đã từ chối</span>
            <h2>@CountStatus("REJECTED")</h2>
        </div>

    </div>

    <div class="content-card">

        <div class="toolbar">
            <input placeholder="Tìm kiếm tên dự án hoặc giảng viên..."
                   @bind="SearchText"
                   @bind:event="oninput" />

            <select @bind="SelectedStatus">
                <option value="">Tất cả trạng thái</option>
                <option value="PENDING">Chờ phê duyệt</option>
                <option value="APPROVED">Đã phê duyệt</option>
                <option value="REJECTED">Đã từ chối</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Tên dự án</th>
                        <th>Giảng viên</th>
                        <th>Ngày gửi</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var project in PagedProjects)
                    {
                        <tr>
                            <td>@project.Name</td>
                            <td>@project.Lecturer</td>
                            <td>@project.SubmittedDate</td>
                            <td>
                                <span class="status-badge @GetStatusClass(project.Status)">
                                    @GetStatusName(project.Status)
                                </span>
                            </td>

                            <td>
                                <button class="btn-detail"
                                        @onclick="() => ViewProject(project)">
                                    Chi tiết
                                </button>
                            </td>
                        </tr>
                    }

                    @if (!PagedProjects.Any())
                    {
                        <tr>
                            <td colspan="5" class="empty">
                                Không có dự án phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (FilteredProjects.Any())
        {
            <div class="pagination">
                <span class="page-info">
                    Hiển thị @PagedProjects.Count() / @FilteredProjects.Count() dự án
                </span>

                <div class="page-controls">
                    <button class="page-btn"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="() => ChangePage(CurrentPage - 1)">
                        Trước
                    </button>

                    <span class="page-current">Trang @CurrentPage / @TotalPages</span>

                    <button class="page-btn"
                            disabled="@(CurrentPage >= TotalPages)"
                            @onclick="() => ChangePage(CurrentPage + 1)">
                        Sau
                    </button>
                </div>
            </div>
        }

    </div>

    @if (SelectedProject != null)
    {
        <div class="modal-overlay">
            <div class="modal">

                <h2>Thông tin dự án</h2>

                <div class="detail-item">
                    <strong>Tên dự án:</strong>
                    <p>@SelectedProject.Name</p>
                </div>

                <div class="detail-item">
                    <strong>Giảng viên:</strong>
                    <p>@SelectedProject.Lecturer</p>
                </div>

                <div class="detail-item">
                    <strong>Ngày gửi:</strong>
                    <p>@SelectedProject.SubmittedDate</p>
                </div>

                <div class="detail-item">
                    <strong>Mô tả:</strong>
                    <p>@SelectedProject.Description</p>
                </div>

                <div class="detail-item">
                    <strong>Trạng thái:</strong>
                    <p>@GetStatusName(SelectedProject.Status)</p>
                </div>

                @if (SelectedProject.Status == "REJECTED" && !string.IsNullOrWhiteSpace(SelectedProject.RejectionReason))
                {
                    <div class="detail-item">
                        <strong>Lý do từ chối:</strong>
                        <p class="rejected-text">@SelectedProject.RejectionReason</p>
                    </div>
                }

                @if (SelectedProject.Status == "PENDING")
                {
                    <label>Lý do từ chối (nếu có)</label>

                    <textarea @bind="RejectionReason"
                              placeholder="Nhập lý do từ chối...">
                    </textarea>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <p class="error-message">@ErrorMessage</p>
                    }

                    <div class="modal-actions">
                        <button class="btn-approve"
                                @onclick="ApproveProject">
                            Phê duyệt
                        </button>

                        <button class="btn-reject"
                                @onclick="RejectProject">
                            Từ chối
                        </button>
                    </div>
                }

                <button class="btn-close"
                        @onclick="CloseDetails">
                    Đóng
                </button>

            </div>
        </div>
    }

</div>

@code {
    private string _searchText = "";
    private string SearchText
    {
        get => _searchText;
        set { _searchText = value; CurrentPage = 1; }
    }

    private string _selectedStatus = "";
    private string SelectedStatus
    {
        get => _selectedStatus;
        set { _selectedStatus = value; CurrentPage = 1; }
    }

    private string RejectionReason = "";
    private string ErrorMessage = "";

    private int CurrentPage = 1;
    private int PageSize = 5;

    private ProjectModel? SelectedProject;

    private List<ProjectModel> Projects = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiProjects = await Http.GetFromJsonAsync<List<ProjectModel>>("api/projects");
            if (apiProjects != null && apiProjects.Any())
            {
                Projects = apiProjects;
                return;
            }
        }
        catch
        {
            // Dùng dữ liệu mẫu bên dưới nếu API chưa kết nối
        }

        Projects = new List<ProjectModel>
        {
            new()
            {
                Id = "PRJ-01",
                Name = "Hệ thống quản lý học tập PBL CollabSphere",
                Lecturer = "ThS. Nguyễn Văn An",
                SubmittedDate = "15/11/2026",
                Description = "Nền tảng hỗ trợ làm việc nhóm, quản lý checkpoint và đánh giá theo môn học.",
                Status = "PENDING"
            },
            new()
            {
                Id = "PRJ-02",
                Name = "Ứng dụng đặt lịch khám bệnh trực tuyến",
                Lecturer = "TS. Trần Thị Bình",
                SubmittedDate = "12/11/2026",
                Description = "Hệ thống đặt lịch, quản lý hồ sơ bệnh nhân và nhắc lịch tự động.",
                Status = "APPROVED"
            },
            new()
            {
                Id = "PRJ-03",
                Name = "Website quản lý bán hàng đa chi nhánh",
                Lecturer = "ThS. Lê Hoàng Cường",
                SubmittedDate = "10/11/2026",
                Description = "Quản lý tồn kho, đơn hàng và báo cáo doanh thu theo thời gian thực.",
                Status = "REJECTED",
                RejectionReason = "Phạm vi chức năng còn sơ sài, cần bổ sung phân tích nghiệp vụ và sơ đồ CSDL."
            }
        };
    }

    private IEnumerable<ProjectModel> FilteredProjects =>
        Projects.Where(project =>
            (string.IsNullOrWhiteSpace(SearchText) ||
             project.Name.Contains(
                 SearchText,
                 StringComparison.OrdinalIgnoreCase
             ) ||
             project.Lecturer.Contains(
                 SearchText,
                 StringComparison.OrdinalIgnoreCase
             )) &&
            (string.IsNullOrWhiteSpace(SelectedStatus) ||
             project.Status == SelectedStatus)
        );

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredProjects.Count() / PageSize));

    private IEnumerable<ProjectModel> PagedProjects =>
        FilteredProjects.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private int CountStatus(string status)
    {
        return Projects.Count(x => x.Status == status);
    }

    private string GetStatusName(string status)
    {
        return status switch
        {
            "PENDING" => "Chờ phê duyệt",
            "APPROVED" => "Đã phê duyệt",
            "REJECTED" => "Đã từ chối",
            _ => status
        };
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "APPROVED" => "approved",
            "REJECTED" => "rejected",
            _ => "pending"
        };
    }

    private void ViewProject(ProjectModel project)
    {
        SelectedProject = project;
        RejectionReason = "";
        ErrorMessage = "";
    }

    private async Task ApproveProject()
    {
        if (SelectedProject == null ||
            SelectedProject.Status != "PENDING")
            return;

        try
        {
            await Http.PatchAsJsonAsync($"api/projects/{SelectedProject.Id}/status", new
            {
                status = "APPROVED",
                rejectionReason = ""
            });
        }
        catch { }

        SelectedProject.Status = "APPROVED";
        SelectedProject.RejectionReason = "";

        CloseDetails();
    }

    private async Task RejectProject()
    {
        if (SelectedProject == null ||
            SelectedProject.Status != "PENDING")
            return;

        if (string.IsNullOrWhiteSpace(RejectionReason))
        {
            ErrorMessage = "Vui lòng nhập lý do từ chối dự án.";
            return;
        }

        string reason = RejectionReason.Trim();

        try
        {
            await Http.PatchAsJsonAsync($"api/projects/{SelectedProject.Id}/status", new
            {
                status = "REJECTED",
                rejectionReason = reason
            });
        }
        catch { }

        SelectedProject.Status = "REJECTED";
        SelectedProject.RejectionReason = reason;

        CloseDetails();
    }

    private void CloseDetails()
    {
        SelectedProject = null;
        RejectionReason = "";
        ErrorMessage = "";
    }

    public class ProjectModel
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N")[..6].ToUpper();
        public string Name { get; set; } = "";
        public string Lecturer { get; set; } = "";
        public string SubmittedDate { get; set; } = "";
        public string Description { get; set; } = "";
        public string Status { get; set; } = "PENDING";
        public string RejectionReason { get; set; } = "";
    }
}

<style>
    .page-container {
        padding: 28px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .page-header {
        margin-bottom: 28px;
    }

    .page-header h1 {
        color: #1e293b;
        font-size: 26px;
    }

    .page-header p {
        color: #64748b;
    }

    .statistics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card, .content-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .stat-card span {
        color: #64748b;
    }

    .stat-card h2 {
        color: #2563eb;
        font-size: 28px;
    }

    .toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
    }

    input, select, textarea {
        padding: 11px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
    }

    .toolbar input {
        flex: 1;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 15px;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
    }

    th {
        background: #f8fafc;
        color: #475569;
    }

    .status-badge {
        color: #1d4ed8;
        background: #dbeafe;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 13px;
        white-space: nowrap;
    }

    .status-badge.pending {
        background: #fef3c7;
        color: #b45309;
    }

    .status-badge.approved {
        background: #dcfce7;
        color: #15803d;
    }

    .status-badge.rejected {
        background: #fee2e2;
        color: #dc2626;
    }

    button {
        cursor: pointer;
        border: none;
        border-radius: 6px;
