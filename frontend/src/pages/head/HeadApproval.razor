    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(15, 23, 42, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .modal {
        background: white;
        padding: 28px;
        border-radius: 12px;
        width: 100%;
        max-width: 550px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal h2 {
        color: #1e293b;
    }

    .detail-item p {
        color: #64748b;
        margin: 5px 0;
    }

    .rejected-text {
        color: #dc2626 !important;
    }

    .error-message {
        color: #dc2626;
        font-size: 14px;
        margin: 0;
    }

    .modal textarea {
        min-height: 90px;
        resize: vertical;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .btn-approve {
        background: #16a34a;
        color: white;
    }

    .btn-reject {
        background: #dc2626;
        color: white;
    }

    .btn-close {
        background: #e2e8f0;
    }

    .empty {
