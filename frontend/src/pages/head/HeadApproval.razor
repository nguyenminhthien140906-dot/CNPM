
@page "/head/approval"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "HEAD")]

<PageTitle>Phê duyệt dự án</PageTitle>

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>Phê duyệt dự án</h1>
            <p>
                Xem xét và phê duyệt các dự án học tập
                được gửi từ giảng viên.
            </p>
        </div>
    </div>

    <div class="statistics">

        <div class="stat-card">
            <span>Chờ phê duyệt</span>
            <h2>@CountStatus("PENDING")</h2>
        </div>

        <div class="stat-card">
            <span>Đã phê duyệt</span>
            <h2>@CountStatus("APPROVED")</h2>
        </div>

        <div class="stat-card">
            <span>Đã từ chối</span>
            <h2>@CountStatus("REJECTED")</h2>
        </div>

    </div>

    <div class="content-card">

        <div class="toolbar">
            <input placeholder="Tìm kiếm dự án..."
                   @bind="SearchText"
                   @bind:event="oninput" />

            <select @bind="SelectedStatus">
                <option value="">Tất cả trạng thái</option>
                <option value="PENDING">Chờ phê duyệt</option>
                <option value="APPROVED">Đã phê duyệt</option>
                <option value="REJECTED">Đã từ chối</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Tên dự án</th>
                        <th>Giảng viên</th>
                        <th>Ngày gửi</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var project in FilteredProjects)
                    {
                        <tr>
                            <td>@project.Name</td>
                            <td>@project.Lecturer</td>
                            <td>@project.SubmittedDate</td>
                            <td>
                                <span class="status-badge">
                                    @GetStatusName(project.Status)
                                </span>
                            </td>

                            <td>
                                <button class="btn-detail"
                                        @onclick="() => ViewProject(project)">
                                    Chi tiết
                                </button>
                            </td>
                        </tr>
                    }

                    @if (!FilteredProjects.Any())
                    {
                        <tr>
                            <td colspan="5" class="empty">
                                Không có dự án phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    @if (SelectedProject != null)
    {
        <div class="modal-overlay">
            <div class="modal">

                <h2>Thông tin dự án</h2>

                <div class="detail-item">
                    <strong>Tên dự án:</strong>
                    <p>@SelectedProject.Name</p>
                </div>

                <div class="detail-item">
                    <strong>Giảng viên:</strong>
                    <p>@SelectedProject.Lecturer</p>
                </div>

                <div class="detail-item">
                    <strong>Mô tả:</strong>
                    <p>@SelectedProject.Description</p>
                </div>

                <div class="detail-item">
                    <strong>Trạng thái:</strong>
                    <p>@GetStatusName(SelectedProject.Status)</p>
                </div>

                @if (SelectedProject.Status == "PENDING")
                {
                    <label>Lý do từ chối (nếu có)</label>

                    <textarea @bind="RejectionReason"
                              placeholder="Nhập lý do từ chối...">
                    </textarea>

                    <div class="modal-actions">
                        <button class="btn-approve"
                                @onclick="ApproveProject">
                            Phê duyệt
                        </button>

                        <button class="btn-reject"
                                @onclick="RejectProject">
                            Từ chối
                        </button>
                    </div>
                }

                <button class="btn-close"
                        @onclick="CloseDetails">
                    Đóng
                </button>

            </div>
        </div>
    }

</div>

@code {
    private string SearchText = "";
    private string SelectedStatus = "";
    private string RejectionReason = "";

    private ProjectModel? SelectedProject;

    private List<ProjectModel> Projects = new();

    private IEnumerable<ProjectModel> FilteredProjects =>
        Projects.Where(project =>
            (string.IsNullOrWhiteSpace(SearchText) ||
             project.Name.Contains(
                 SearchText,
                 StringComparison.OrdinalIgnoreCase
             )) &&
            (string.IsNullOrWhiteSpace(SelectedStatus) ||
             project.Status == SelectedStatus)
        );

    private int CountStatus(string status)
    {
        return Projects.Count(x => x.Status == status);
    }

    private string GetStatusName(string status)
    {
        return status switch
        {
            "PENDING" => "Chờ phê duyệt",
            "APPROVED" => "Đã phê duyệt",
            "REJECTED" => "Đã từ chối",
            _ => status
        };
    }

    private void ViewProject(ProjectModel project)
    {
        SelectedProject = project;
        RejectionReason = "";
    }

    private void ApproveProject()
    {
        if (SelectedProject == null ||
            SelectedProject.Status != "PENDING")
            return;

        SelectedProject.Status = "APPROVED";
        SelectedProject.RejectionReason = "";

        CloseDetails();
    }

    private void RejectProject()
    {
        if (SelectedProject == null ||
            SelectedProject.Status != "PENDING" ||
            string.IsNullOrWhiteSpace(RejectionReason))
            return;

        SelectedProject.Status = "REJECTED";
        SelectedProject.RejectionReason = RejectionReason.Trim();

        CloseDetails();
    }

    private void CloseDetails()
    {
        SelectedProject = null;
        RejectionReason = "";
    }

    public class ProjectModel
    {
        public string Name { get; set; } = "";
        public string Lecturer { get; set; } = "";
        public string SubmittedDate { get; set; } = "";
        public string Description { get; set; } = "";
        public string Status { get; set; } = "PENDING";
        public string RejectionReason { get; set; } = "";
    }
}

<style>
    .page-container {
        padding: 28px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .page-header {
        margin-bottom: 28px;
    }

    .page-header h1 {
        color: #1e293b;
        font-size: 26px;
    }

    .page-header p {
        color: #64748b;
    }

    .statistics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card, .content-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .stat-card span {
        color: #64748b;
    }

    .stat-card h2 {
        color: #2563eb;
        font-size: 28px;
    }

    .toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
    }

    input, select, textarea {
        padding: 11px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
    }

    .toolbar input {
        flex: 1;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 15px;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
    }

    th {
        background: #f8fafc;
        color: #475569;
    }

    .status-badge {
        color: #1d4ed8;
        background: #dbeafe;
        padding: 6px 10px;
        border-radius: 20px;
    }

    button {
        cursor: pointer;
        border: none;
        border-radius: 6px;
        padding: 9px 14px;
    }

    .btn-detail {
        background: #eff6ff;
        color: #2563eb;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(15, 23, 42, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .modal {
        background: white;
        padding: 28px;
        border-radius: 12px;
        width: 100%;
        max-width: 550px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal h2 {
        color: #1e293b;
    }

    .detail-item p {
        color: #64748b;
        margin: 5px 0;
    }

    .modal textarea {
        min-height: 90px;
        resize: vertical;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .btn-approve {
        background: #16a34a;
        color: white;
    }

    .btn-reject {
        background: #dc2626;
        color: white;
    }

    .btn-close {
        background: #e2e8f0;
    }

    .empty {
        text-align: center;
        color: #94a3b8;
    }
</style>
