
@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">

    <div class="dashboard-header">
        <div>
            <h1>Tổng quan hệ thống</h1>
            <p>Chào mừng đến với CollabSphere.</p>
        </div>

        <div class="header-actions">
            <button class="refresh-btn" @onclick="LoadDashboardData" disabled="@IsLoading">
                @(IsLoading ? "Đang tải..." : "↻ Làm mới")
            </button>
            <span class="date-label">@DateTime.Today.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon">📁</div>
            <p>Tổng dự án</p>
            <h2>@TotalProjects</h2>
            <span>Trong hệ thống</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon">🏫</div>
            <p>Lớp học</p>
            <h2>@TotalClasses</h2>
            <span>Lớp đang quản lý</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <p>Nhóm học tập</p>
            <h2>@TotalTeams</h2>
            <span>Nhóm đang hoạt động</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📋</div>
            <p>Nhiệm vụ</p>
            <h2>@TotalTasks</h2>
            <span>Nhiệm vụ đã ghi nhận</span>
        </div>

    </div>

    <div class="dashboard-grid">

        <div class="content-card">
            <div class="section-header">
                <h3>Dự án gần đây</h3>
                <a href="/projects">Xem tất cả</a>
            </div>

            @foreach (var project in RecentProjects)
            {
                <div class="project-item">
                    <div>
                        <strong>@project.Name</strong>
                        <p>@project.Description</p>
                    </div>

                    <span class="status-badge">
                        @project.Status
                    </span>
                </div>
            }

            @if (!RecentProjects.Any())
            {
                <p>Chưa có dự án nào.</p>
            }
        </div>

        <div class="content-card">
            <div class="section-header">
                <h3>Tiến độ nhiệm vụ</h3>
                <a href="/tasks">Chi tiết</a>
            </div>

            <div class="progress-item">
                <div class="progress-label">
                    <span>Hoàn thành</span>
                    <strong>@CompletedTasks / @TotalTasks</strong>
                </div>

                <div class="progress-bar">
                    <div class="progress-value"
                         style="@($"width: {TaskProgress}%")">
                    </div>
                </div>

                <p>@TaskProgress% nhiệm vụ đã hoàn thành.</p>
            </div>

            <div class="progress-item">
                <div class="progress-label">
                    <span>Đang thực hiện</span>
                    <strong>@InProgressTasks</strong>
                </div>
            </div>

            <div class="progress-item">
                <div class="progress-label">
                    <span>Chưa bắt đầu</span>
                    <strong>@PendingTasks</strong>
                </div>
            </div>
        </div>

    </div>

    <div class="content-card checkpoint-card">
        <div class="section-header">
            <h3>Checkpoint sắp đến hạn</h3>
            <a href="/checkpoints">Xem tất cả</a>
        </div>

        <div class="checkpoint-toolbar">
            <input type="text"
                   placeholder="Tìm checkpoint hoặc dự án..."
                   @bind="CheckpointSearch"
                   @bind:event="oninput" />

            <select @bind="CheckpointStatusFilter">
                <option value="">Tất cả trạng thái</option>
                <option value="Đang thực hiện">Đang thực hiện</option>
                <option value="Chưa bắt đầu">Chưa bắt đầu</option>
                <option value="Hoàn thành">Hoàn thành</option>
            </select>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Checkpoint</th>
                    <th>Dự án</th>
                    <th>Thời hạn</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in FilteredCheckpoints)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Project</td>
                        <td>@item.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status-badge">@item.Status</span>
                        </td>
                    </tr>
                }

                @if (!FilteredCheckpoints.Any())
                {
                    <tr>
                        <td colspan="4" class="empty-cell">Không có checkpoint phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="quick-links">
        <h3>Truy cập nhanh</h3>

        <div class="quick-grid">
            <a href="/admin/users">Quản lý tài khoản</a>
            <a href="/subjects">Môn học & Syllabus</a>
            <a href="/head/approvals">Phê duyệt dự án</a>
            <a href="/projects">Quản lý dự án</a>
            <a href="/staff/classes">Danh sách lớp</a>
            <a href="/teams">Nhóm học tập</a>
            <a href="/tasks">Nhiệm vụ</a>
            <a href="/assessments">Đánh giá</a>
            <a href="/reports">Báo cáo</a>
        </div>
    </div>

</div>

@code {
    private bool IsLoading = false;
    private string CheckpointSearch = "";
    private string CheckpointStatusFilter = "";

    private int TotalProjects = 12;
    private int TotalClasses = 8;
    private int TotalTeams = 20;
    private int TotalTasks = 45;

    private int CompletedTasks = 25;
    private int InProgressTasks = 12;
    private int PendingTasks = 8;

    private int TaskProgress =>
        TotalTasks == 0 ? 0 :
        (int)Math.Round((double)CompletedTasks / TotalTasks * 100);

    private List<ProjectItem> RecentProjects = new()
    {
        new()
        {
            Name = "CollabSphere",
            Description = "Hệ thống hỗ trợ học tập PBL.",
            Status = "Đang thực hiện"
        },
        new()
        {
            Name = "Website bán hàng",
            Description = "Xây dựng hệ thống thương mại điện tử.",
            Status = "Hoàn thành"
        },
        new()
        {
            Name = "Ứng dụng học tập",
            Description = "Ứng dụng quản lý hoạt động học tập.",
            Status = "Đang thực hiện"
        }
    };

    private List<CheckpointItem> UpcomingCheckpoints = new()
    {
        new()
        {
            Name = "Hoàn thành giao diện",
            Project = "CollabSphere",
            DueDate = DateTime.Today.AddDays(3),
            Status = "Đang thực hiện"
        },
        new()
        {
            Name = "Kiểm thử hệ thống",
            Project = "Website bán hàng",
            DueDate = DateTime.Today.AddDays(7),
            Status = "Chưa bắt đầu"
        }
    };

    private IEnumerable<CheckpointItem> FilteredCheckpoints =>
        UpcomingCheckpoints.Where(c =>
            (string.IsNullOrWhiteSpace(CheckpointSearch) ||
             c.Name.Contains(CheckpointSearch, StringComparison.OrdinalIgnoreCase) ||
             c.Project.Contains(CheckpointSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(CheckpointStatusFilter) ||
             c.Status == CheckpointStatusFilter)
        );

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        IsLoading = true;
        try
        {
            var summary = await Http.GetFromJsonAsync<DashboardSummaryDto>("api/dashboard");
            if (summary != null)
            {
                TotalProjects = summary.TotalProjects;
                TotalClasses = summary.TotalClasses;
                TotalTeams = summary.TotalTeams;
                TotalTasks = summary.TotalTasks;
                CompletedTasks = summary.CompletedTasks;
                InProgressTasks = summary.InProgressTasks;
                PendingTasks = summary.PendingTasks;

                if (summary.RecentProjects != null && summary.RecentProjects.Any())
                    RecentProjects = summary.RecentProjects;

                if (summary.UpcomingCheckpoints != null && summary.UpcomingCheckpoints.Any())
                    UpcomingCheckpoints = summary.UpcomingCheckpoints;
            }
        }
        catch
        {
            // Giữ nguyên dữ liệu mẫu mặc định khi API chưa kết nối
        }
        finally
        {
            IsLoading = false;
        }
    }

    public class DashboardSummaryDto
    {
        public int TotalProjects { get; set; }
        public int TotalClasses { get; set; }
        public int TotalTeams { get; set; }
        public int TotalTasks { get; set; }
        public int CompletedTasks { get; set; }
        public int InProgressTasks { get; set; }
        public int PendingTasks { get; set; }
        public List<ProjectItem>? RecentProjects { get; set; }
        public List<CheckpointItem>? UpcomingCheckpoints { get; set; }
    }

    public class ProjectItem
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Status { get; set; } = "";
    }

    public class CheckpointItem
    {
        public string Name { get; set; } = "";
        public string Project { get; set; } = "";
        public DateTime DueDate { get; set; }
        public string Status { get; set; } = "";
    }
}

