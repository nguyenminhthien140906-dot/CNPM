
@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">

    <div class="dashboard-header">
        <div>
            <h1>Tổng quan hệ thống</h1>
            <p>Chào mừng đến với CollabSphere.</p>
        </div>

        <span class="date-label">@DateTime.Today.ToString("dd/MM/yyyy")</span>
    </div>

    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon">📁</div>
            <p>Tổng dự án</p>
            <h2>@TotalProjects</h2>
            <span>Trong hệ thống</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon">🏫</div>
            <p>Lớp học</p>
            <h2>@TotalClasses</h2>
            <span>Lớp đang quản lý</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <p>Nhóm học tập</p>
            <h2>@TotalTeams</h2>
            <span>Nhóm đang hoạt động</span>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📋</div>
            <p>Nhiệm vụ</p>
            <h2>@TotalTasks</h2>
            <span>Nhiệm vụ đã ghi nhận</span>
        </div>

    </div>

    <div class="dashboard-grid">

        <div class="content-card">
            <div class="section-header">
                <h3>Dự án gần đây</h3>
                <a href="/projects">Xem tất cả</a>
            </div>

            @foreach (var project in RecentProjects)
            {
                <div class="project-item">
                    <div>
                        <strong>@project.Name</strong>
                        <p>@project.Description</p>
                    </div>

                    <span class="status-badge">
                        @project.Status
                    </span>
                </div>
            }

            @if (!RecentProjects.Any())
            {
                <p>Chưa có dự án nào.</p>
            }
        </div>

        <div class="content-card">
            <div class="section-header">
                <h3>Tiến độ nhiệm vụ</h3>
                <a href="/tasks">Chi tiết</a>
            </div>

            <div class="progress-item">
                <div class="progress-label">
                    <span>Hoàn thành</span>
                    <strong>@CompletedTasks / @TotalTasks</strong>
                </div>

                <div class="progress-bar">
                    <div class="progress-value"
                         style="@($"width: {TaskProgress}%")">
                    </div>
                </div>

                <p>@TaskProgress% nhiệm vụ đã hoàn thành.</p>
            </div>

            <div class="progress-item">
                <div class="progress-label">
                    <span>Đang thực hiện</span>
                    <strong>@InProgressTasks</strong>
                </div>
            </div>

            <div class="progress-item">
                <div class="progress-label">
                    <span>Chưa bắt đầu</span>
                    <strong>@PendingTasks</strong>
                </div>
            </div>
        </div>

    </div>

    <div class="content-card checkpoint-card">
        <div class="section-header">
            <h3>Checkpoint sắp đến hạn</h3>
            <a href="/checkpoints">Xem tất cả</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Checkpoint</th>
                    <th>Dự án</th>
                    <th>Thời hạn</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in UpcomingCheckpoints)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Project</td>
                        <td>@item.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.Status</td>
                    </tr>
                }

                @if (!UpcomingCheckpoints.Any())
                {
                    <tr>
                        <td colspan="4">Không có checkpoint sắp đến hạn.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="quick-links">
        <h3>Truy cập nhanh</h3>

        <div class="quick-grid">
            <a href="/projects">Quản lý dự án</a>
            <a href="/classes">Danh sách lớp</a>
            <a href="/teams">Nhóm học tập</a>
            <a href="/tasks">Nhiệm vụ</a>
            <a href="/assessments">Đánh giá</a>
            <a href="/reports">Báo cáo</a>
        </div>
    </div>

</div>

@code {
    private int TotalProjects = 12;
    private int TotalClasses = 8;
    private int TotalTeams = 20;
    private int TotalTasks = 45;

    private int CompletedTasks = 25;
    private int InProgressTasks = 12;
    private int PendingTasks = 8;

    private int TaskProgress =>
        TotalTasks == 0 ? 0 :
        (int)Math.Round((double)CompletedTasks / TotalTasks * 100);

    private List<ProjectItem> RecentProjects = new()
    {
        new()
        {
            Name = "CollabSphere",
            Description = "Hệ thống hỗ trợ học tập PBL.",
            Status = "Đang thực hiện"
        },
        new()
        {
            Name = "Website bán hàng",
            Description = "Xây dựng hệ thống thương mại điện tử.",
            Status = "Hoàn thành"
        },
        new()
        {
            Name = "Ứng dụng học tập",
            Description = "Ứng dụng quản lý hoạt động học tập.",
            Status = "Đang thực hiện"
        }
    };

    private List<CheckpointItem> UpcomingCheckpoints = new()
    {
        new()
        {
            Name = "Hoàn thành giao diện",
            Project = "CollabSphere",
            DueDate = DateTime.Today.AddDays(3),
            Status = "Đang thực hiện"
        },
        new()
        {
            Name = "Kiểm thử hệ thống",
            Project = "Website bán hàng",
            DueDate = DateTime.Today.AddDays(7),
            Status = "Chưa bắt đầu"
        }
    };

    public class ProjectItem
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Status { get; set; } = "";
    }

    public class CheckpointItem
    {
        public string Name { get; set; } = "";
        public string Project { get; set; } = "";
        public DateTime DueDate { get; set; }
        public string Status { get; set; } = "";
    }
}

<style>
    .dashboard-container {
        padding: 28px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .dashboard-header h1 {
        color: #1e293b;
        font-size: 27px;
    }

    .dashboard-header p {
        color: #64748b;
    }

    .date-label {
        background: white;
        padding: 12px 18px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .stat-card, .content-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .stat-icon {
        font-size: 26px;
    }

    .stat-card p {
        color: #64748b;
    }

    .stat-card h2 {
        color: #2563eb;
        font-size: 30px;
        margin: 8px 0;
    }

    .stat-card span {
        color: #94a3b8;
        font-size: 13px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .section-header h3 {
        color: #1e293b;
    }

    .section-header a {
        color: #2563eb;
        text-decoration: none;
    }

    .project-item {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .project-item p {
        color: #64748b;
        font-size: 13px;
    }

    .status-badge {
        color: #2563eb;
        background: #dbeafe;
        padding: 6px 10px;
        border-radius: 20px;
        white-space: nowrap;
        font-size: 12px;
        height: fit-content;
    }

    .progress-item {
        margin-bottom: 24px;
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .progress-bar {
        height: 9px;
        background: #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-value {
        height: 100%;
        background: #2563eb;
        border-radius: 10px;
    }

    .progress-item p {
        color: #64748b;
        font-size: 13px;
    }

    .checkpoint-card {
        margin-bottom: 24px;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 14px;
        text-align: left;
        border-bottom: 1px solid #e2e8f0;
    }

    th {
        background: #f8fafc;
    }

    .quick-links {
        margin-top: 25px;
    }

    .quick-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 15px;
    }

    .quick-grid a {
        padding: 20px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        color: #2563eb;
        text-decoration: none;
    }

    .quick-grid a:hover {
        border-color: #2563eb;
        background: #eff6ff;
    }

    @media(max-width: 900px) {
        .stat-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

    @media(max-width: 600px) {
        .quick-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
