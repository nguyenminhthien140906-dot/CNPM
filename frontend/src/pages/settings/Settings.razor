
@page "/settings"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Cài đặt hệ thống</PageTitle>

<div class="page-container">

    <div class="page-header">
        <h1>Cài đặt hệ thống</h1>
        <p>Quản lý thông tin cá nhân và tùy chỉnh CollabSphere.</p>
    </div>

    <div class="settings-layout">

        <div class="settings-menu">
            <button class="@GetMenuClass("profile")"
                    @onclick="() => SelectTab("profile")">
                Thông tin cá nhân
            </button>

            <button class="@GetMenuClass("security")"
                    @onclick="() => SelectTab("security")">
                Bảo mật
            </button>

            <button class="@GetMenuClass("notifications")"
                    @onclick="() => SelectTab("notifications")">
                Thông báo
            </button>

            <button class="@GetMenuClass("system")"
                    @onclick="() => SelectTab("system")">
                Hệ thống
            </button>
        </div>

        <div class="settings-content">

            @if (SelectedTab == "profile")
            {
                <h2>Thông tin cá nhân</h2>
                <p>Cập nhật thông tin tài khoản của bạn.</p>

                <div class="form-group">
                    <label>Họ và tên</label>
                    <input @bind="Profile.FullName" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" @bind="Profile.Email" />
                </div>

                <div class="form-group">
                    <label>Số điện thoại</label>
                    <input @bind="Profile.Phone" />
                </div>

                <div class="form-group">
                    <label>Vai trò</label>
                    <input value="@Profile.Role" disabled />
                </div>

                <button class="btn-primary" @onclick="SaveProfile">
                    Lưu thông tin
                </button>
            }

            else if (SelectedTab == "security")
            {
                <h2>Bảo mật tài khoản</h2>
                <p>Thay đổi mật khẩu để bảo vệ tài khoản.</p>

                <div class="form-group">
                    <label>Mật khẩu hiện tại</label>
                    <input type="password"
                           @bind="Security.CurrentPassword" />
                </div>

                <div class="form-group">
                    <label>Mật khẩu mới</label>
                    <input type="password"
                           @bind="Security.NewPassword" />
                </div>

                <div class="form-group">
                    <label>Xác nhận mật khẩu mới</label>
                    <input type="password"
                           @bind="Security.ConfirmPassword" />
                </div>

                <button class="btn-primary" @onclick="ChangePassword">
                    Cập nhật mật khẩu
                </button>
            }

            else if (SelectedTab == "notifications")
            {
                <h2>Cài đặt thông báo</h2>
                <p>Chọn những thông báo bạn muốn nhận.</p>

                <div class="setting-item">
                    <div>
                        <strong>Thông báo nhiệm vụ</strong>
                        <p>Nhận thông báo khi có nhiệm vụ mới.</p>
                    </div>
                    <input type="checkbox"
                           @bind="Notifications.TaskNotifications" />
                </div>

                <div class="setting-item">
                    <div>
                        <strong>Thông báo dự án</strong>
                        <p>Nhận thông báo về tiến độ dự án.</p>
                    </div>
                    <input type="checkbox"
                           @bind="Notifications.ProjectNotifications" />
                </div>

                <div class="setting-item">
                    <div>
                        <strong>Thông báo đánh giá</strong>
                        <p>Nhận thông báo khi có kết quả đánh giá.</p>
                    </div>
                    <input type="checkbox"
                           @bind="Notifications.AssessmentNotifications" />
                </div>

                <div class="setting-item">
                    <div>
                        <strong>Thông báo checkpoint</strong>
                        <p>Nhận thông báo về thời hạn checkpoint.</p>
                    </div>
                    <input type="checkbox"
                           @bind="Notifications.CheckpointNotifications" />
                </div>

                <button class="btn-primary"
                        @onclick="SaveNotifications">
                    Lưu cài đặt
                </button>
            }

            else if (SelectedTab == "system")
            {
                <h2>Cài đặt hệ thống</h2>
                <p>Tùy chỉnh giao diện và ngôn ngữ.</p>

                <div class="form-group">
                    <label>Ngôn ngữ</label>
                    <select @bind="SystemSettings.Language">
                        <option value="vi">Tiếng Việt</option>
                        <option value="en">English</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Giao diện</label>
                    <select @bind="SystemSettings.Theme">
                        <option value="light">Sáng</option>
                        <option value="dark">Tối</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Múi giờ</label>
                    <select @bind="SystemSettings.TimeZone">
                        <option value="Asia/Ho_Chi_Minh">
                            Việt Nam (UTC+7)
                        </option>
                        <option value="UTC">
                            UTC
                        </option>
                    </select>
                </div>

                <button class="btn-primary"
                        @onclick="SaveSystemSettings">
                    Lưu cài đặt
                </button>
            }

            @if (!string.IsNullOrEmpty(Message))
            {
                <p class="success-message">@Message</p>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="error-message">@ErrorMessage</p>
            }

        </div>
    </div>

</div>

@code {
    private string SelectedTab = "profile";

    private string Message = "";
    private string ErrorMessage = "";

    private ProfileModel Profile = new()
    {
        FullName = "Nguyễn Văn A",
        Email = "user@example.com",
        Phone = "0900000000",
        Role = "Student"
    };

    private SecurityModel Security = new();

    private NotificationModel Notifications = new();

    private SystemSettingModel SystemSettings = new();

    private void SelectTab(string tab)
    {
        SelectedTab = tab;
        Message = "";
        ErrorMessage = "";
    }

    private string GetMenuClass(string tab)
    {
        return SelectedTab == tab
            ? "menu-button active"
            : "menu-button";
    }

    private void SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(Profile.FullName) ||
            string.IsNullOrWhiteSpace(Profile.Email))
        {
            ErrorMessage = "Vui lòng nhập họ tên và email.";
            Message = "";
            return;
        }

        Message = "Thông tin đã được kiểm tra. Cần kết nối API để lưu.";
        ErrorMessage = "";
    }

    private void ChangePassword()
    {
        if (string.IsNullOrWhiteSpace(Security.CurrentPassword) ||
            string.IsNullOrWhiteSpace(Security.NewPassword) ||
            string.IsNullOrWhiteSpace(Security.ConfirmPassword))
        {
            ErrorMessage = "Vui lòng nhập đầy đủ thông tin mật khẩu.";
            Message = "";
            return;
        }

        if (Security.NewPassword.Length < 8)
        {
            ErrorMessage = "Mật khẩu mới phải có ít nhất 8 ký tự.";
            Message = "";
            return;
        }

        if (Security.NewPassword != Security.ConfirmPassword)
        {
            ErrorMessage = "Mật khẩu xác nhận không khớp.";
            Message = "";
            return;
        }

        ErrorMessage = "Chưa kết nối API xác thực để thay đổi mật khẩu.";
        Message = "";
    }

    private void SaveNotifications()
    {
        Message = "Cài đặt thông báo đã được kiểm tra. Cần API để lưu.";
        ErrorMessage = "";
    }

    private void SaveSystemSettings()
    {
        Message = "Cài đặt hệ thống đã được kiểm tra. Cần API để lưu.";
        ErrorMessage = "";
    }

    public class ProfileModel
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Role { get; set; } = "";
    }

    public class SecurityModel
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    public class NotificationModel
    {
        public bool TaskNotifications { get; set; } = true;
        public bool ProjectNotifications { get; set; } = true;
        public bool AssessmentNotifications { get; set; } = true;
        public bool CheckpointNotifications { get; set; } = true;
    }

    public class SystemSettingModel
    {
        public string Language { get; set; } = "vi";
        public string Theme { get; set; } = "light";
        public string TimeZone { get; set; } = "Asia/Ho_Chi_Minh";
    }
}

<style>
    .page-container {
        padding: 28px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .page-header h1 {
        color: #1e293b;
    }

    .page-header p {
        color: #64748b;
        margin-bottom: 25px;
    }

    .settings-layout {
        display: grid;
        grid-template-columns: 230px 1fr;
        gap: 22px;
    }

    .settings-menu, .settings-content {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
    }

    .settings-menu {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: fit-content;
    }

    .menu-button {
        padding: 13px;
        border: none;
        background: transparent;
        color: #475569;
        text-align: left;
        border-radius: 7px;
        cursor: pointer;
    }

    .menu-button.active {
        background: #dbeafe;
        color: #1d4ed8;
        font-weight: 600;
    }

    .settings-content h2 {
        color: #1e293b;
    }

    .settings-content > p {
        color: #64748b;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 20px 0;
        max-width: 550px;
    }

    input, select {
        padding: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
    }

    .btn-primary {
        padding: 12px 18px;
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 7px;
        cursor: pointer;
    }

    .setting-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .setting-item p {
        color: #64748b;
        font-size: 13px;
    }

    .success-message {
        color: #15803d !important;
        margin-top: 20px;
    }

    .error-message {
        color: #dc2626 !important;
        margin-top: 20px;
    }

    @media(max-width: 700px) {
        .settings-layout {
            grid-template-columns: 1fr;
        }

        .settings-menu {
            flex-direction: row;
            flex-wrap: wrap;
        }
    }
</style>
