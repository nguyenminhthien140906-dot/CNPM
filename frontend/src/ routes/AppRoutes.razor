
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(Program).Assembly">

    <Found Context="routeData">

        <AuthorizeRouteView RouteData="@routeData">

            <NotAuthorized Context="authState">

                @if (authState.User.Identity?.IsAuthenticated != true)
                {
                    <section class="route-message">
                        <h2>Yêu cầu đăng nhập</h2>
                        <p>Bạn cần đăng nhập để truy cập chức năng này.</p>
                        <a href="/login">Đăng nhập</a>
                    </section>
                }
                else
                {
                    <section class="route-message">
                        <h2>Không có quyền truy cập</h2>
                        <p>Tài khoản của bạn không được cấp quyền truy cập trang này.</p>
                        <a href="/dashboard">Quay về Dashboard</a>
                    </section>
                }

            </NotAuthorized>

            <Authorizing>
                <section class="route-message">
                    <p>Đang kiểm tra quyền truy cập...</p>
                </section>
            </Authorizing>

        </AuthorizeRouteView>

        <FocusOnNavigate
            RouteData="@routeData"
            Selector="h1" />

    </Found>

    <NotFound>
        <section class="route-message">
            <h1>404</h1>
            <p>Không tìm thấy trang bạn yêu cầu.</p>
            <a href="/dashboard">Quay về Dashboard</a>
        </section>
    </NotFound>

</Router>

<style>
    .route-message {
        max-width: 640px;
        margin: 80px auto;
        padding: 32px;
        text-align: center;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    }

    .route-message h1,
    .route-message h2 {
        margin-bottom: 12px;
    }

    .route-message p {
        margin-bottom: 20px;
        color: #64748b;
    }

    .route-message a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
    }
</style>

